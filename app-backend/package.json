    "firebase-admin": "^13.4.0",
    "google-auth-library": "^10.4.0",
    "mongoose": "^8.10.0",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
