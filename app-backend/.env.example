# Server
PORT=8080

# MongoDB (Railway)
MONGODB_URI=your-mongodb-uri

# JWT
JWT_SECRET=your-jwt-secret

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_WEBHOOK_CONNECT_SECRET=your-stripe-webhook-connect-secret

# AWS S3 (Railway-compatible with custom endpoint)
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_ENDPOINT_URL=your-storage-endpoint-url
S3_BUCKET_NAME=your-main-bucket-name
S3_COLLECTIONS_BUCKET=your-collections-bucket-name
S3_TEST_BUCKET=your-test-bucket-name

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BACKEND_URL=your-backend-server-url


# Frontend URL (for OAuth redirects, Stripe callbacks, etc.)
FRONTEND_URL=https://your-frontend-url

# CORS (comma-separated origins)
ALLOWED_ORIGINS=your-http://localhost:3000,https://your-frontend-url,https://your-dashboard-url

# Branding (optional - leave blank to use defaults)
BRAND_LOGO_URL=your-logo-url
BRAND_EMAIL_HEADER_URL=your-email-header-logo-url
BRAND_EMAIL_FOOTER_URL=your-email-footer-logo-url
BRAND_FAVICON_URL=your-favicon-url