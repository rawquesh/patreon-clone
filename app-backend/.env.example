# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Atlas or self-hosted connection string.
MONGODB_URI=your-mongodb-uri

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_WEBHOOK_CONNECT_SECRET=your-stripe-webhook-connect-secret
# Optional: separate secret for Stripe Connect webhooks on the platform account
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret

# ── AWS S3 / S3-compatible storage ─────────────────────────────────────────
# Works with AWS S3 or any S3-compatible endpoint (e.g. Cloudflare R2, MinIO)
# by setting AWS_ENDPOINT_URL.
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_ENDPOINT_URL=your-storage-endpoint-url
S3_BUCKET_NAME=your-main-bucket-name
S3_COLLECTIONS_BUCKET=your-collections-bucket-name
S3_TEST_BUCKET=your-test-bucket-name
# Public base URL where the main bucket is served from (used to build asset URLs).
S3_ASSETS_BASE_URL=your-public-media-bucket-base-url

# ── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── URLs & CORS ─────────────────────────────────────────────────────────────
# Public base URL of this backend (used for OAuth callbacks, Stripe redirects).
BACKEND_URL=your-backend-server-url
# Public URL of the web frontend (OAuth redirects, share links).
FRONTEND_URL=https://your-frontend-url
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-url,https://your-dashboard-url

# ── Firebase (mobile push notifications — optional) ───────────────────────
# The JSON contents of a Firebase service-account key file, compacted to one
# line, used to initialize the Firebase Admin SDK for FCM push notifications.
FIREBASE_SERVICE_ACCOUNT_KEY_JSON=

# ── Branding (optional — leave blank to use built-in defaults) ────────────
BRAND_LOGO_URL=
BRAND_EMAIL_HEADER_URL=
BRAND_EMAIL_FOOTER_URL=
BRAND_FAVICON_URL=
