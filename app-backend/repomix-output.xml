<file path="src/chat/chat.service.ts">
import {
  BadRequestException,
  ForbiddenException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model, Types } from 'mongoose';
import {
  Chat,
  ChatAccessType,
  ChatParticipant,
  ChatType,
  Message,
} from '@/schemas/chat.schema';
import { User } from '@/schemas/users.schema';
import { Membership } from '@/schemas/membersip.schema';
import { Subscription } from '@/schemas/subscribers.schema';
import {
  ChatDto,
  ChatListItemDto,
  CreateDirectChatDto,
  CreateGroupChatDto,
  GetMessagesQueryDto,
  MarkMessagesReadDto,
  MessageDto,
  SendMessageDto,
  UpdateGroupChatDto,
} from './chat.dto';
import { S3Service } from '@/s3/s3.service';
import { NotificationGeneratorService } from '@/notifications/notification-generator.service';

@Injectable()
export class ChatService {
  constructor(
    @InjectModel(Chat.name) private chatModel: Model<Chat>,
    @InjectModel(ChatParticipant.name)
    private chatParticipantModel: Model<ChatParticipant>,
    @InjectModel(Message.name) private messageModel: Model<Message>,
    @InjectModel(User.name) private userModel: Model<User>,
    @InjectModel(Membership.name) private membershipModel: Model<Membership>,
    @InjectModel(Subscription.name)
    private subscriptionModel: Model<Subscription>,
    private s3Service: S3Service,
    private notificationGenerator: NotificationGeneratorService,
  ) {}

  async createGroupChat(
    userId: string,
    createChatDto: CreateGroupChatDto,
  ): Promise<ChatDto> {
    const user = await this.userModel.findById(userId);
    if (!user) {
      throw new NotFoundException('User not found');
    }

    if (!user.isCreator) {
      throw new ForbiddenException('Only creators can create group chats');
    }

    if (createChatDto.accessType === ChatAccessType.SELECTED) {
      if (
        !createChatDto.accessTiers ||
        createChatDto.accessTiers.length === 0
      ) {
        throw new BadRequestException(
          'Access tiers must be provided when access type is set to "select"',
        );
      }

      const membershipCount = await this.membershipModel.countDocuments({
        _id: {
          $in: createChatDto.accessTiers.map((id) => new Types.ObjectId(id)),
        },
        creator: new Types.ObjectId(userId),
      });

      if (membershipCount !== createChatDto.accessTiers.length) {
        throw new BadRequestException(
          'One or more tiers are invalid or do not belong to this creator',
        );
      }
    }

    let participants = [new Types.ObjectId(userId)];

    if (
      createChatDto.accessType === ChatAccessType.SELECTED &&
      createChatDto.accessTiers?.length
    ) {
      const subscribers = await this.subscriptionModel.find({
        creator: new Types.ObjectId(userId),
        membership: {
          $in: createChatDto.accessTiers.map((id) => new Types.ObjectId(id)),
        },
        status: 'active',
      });

      const subscriberIds = subscribers.map((sub) => sub.subscriber);
      participants = [
        ...new Set([...participants, ...subscriberIds]),
      ] as Types.ObjectId[];
      console.log(participants);
    } else if (createChatDto.accessType === ChatAccessType.PAID) {
      const subscribers = await this.subscriptionModel.find({
        creator: new Types.ObjectId(userId),
        status: 'active',
      });

      const subscriberIds = subscribers.map((sub) => sub.subscriber);
      participants = [
        ...new Set([...participants, ...subscriberIds]),
      ] as Types.ObjectId[];
    }

    const chat = new this.chatModel({
      type: ChatType.GROUP,
      title: createChatDto.title,
      description: createChatDto.description,
      creator: new Types.ObjectId(userId),
      participants: participants,
      accessType: createChatDto.accessType,
      accessTiers: createChatDto.accessTiers?.map(
        (id) => new Types.ObjectId(id),
      ),
    });

    const savedChat = await chat.save();

    const participantEntries = participants.map((participantId) => ({
      chat: savedChat._id,
      user: participantId,
      hasUnreadMessages: participantId.toString() !== userId,
    }));

    await this.chatParticipantModel.insertMany(participantEntries);

    return this.transformChatToDto(savedChat);
  }

  async createDirectChat(
    userId: string,
    createChatDto: CreateDirectChatDto,
  ): Promise<ChatDto> {
    const [user, participant] = await Promise.all([
      this.userModel.findById(userId),
      this.userModel.findById(createChatDto.participantId),
    ]);

    if (!user || !participant) {
      throw new NotFoundException('User not found');
    }

    const isCreatorToSubscriber =
      (user.isCreator && !participant.isCreator) ||
      (!user.isCreator && participant.isCreator);

    if (!isCreatorToSubscriber) {
      throw new BadRequestException(
        'Direct chats can only be created between creators and subscribers',
      );
    }

    const creatorId = user.isCreator ? userId : createChatDto.participantId;
    const subscriberId = user.isCreator ? createChatDto.participantId : userId;

    const subscription = await this.subscriptionModel.findOne({
      creator: new Types.ObjectId(creatorId),
      subscriber: new Types.ObjectId(subscriberId),
      status: 'active',
    });

    if (!subscription) {
      throw new BadRequestException(
        'User must be an active subscriber to create a direct chat with the creator',
      );
    }

    const existingChat = await this.chatModel.findOne({
      type: ChatType.DIRECT,
      participants: {
        $all: [
          new Types.ObjectId(userId),
          new Types.ObjectId(createChatDto.participantId),
        ],
      },
      isDeleted: false,
    });

    if (existingChat) {
      return this.transformChatToDto(existingChat);
    }

    // const creatorUser = user.isCreator ? user : participant;

    const chat = new this.chatModel({
      type: ChatType.DIRECT,
      title: `${user.displayName || user.firstName} & ${participant.displayName || participant.firstName}`,
      creator: new Types.ObjectId(creatorId),
      participants: [
        new Types.ObjectId(userId),
        new Types.ObjectId(createChatDto.participantId),
      ],
    });

    const savedChat = await chat.save();

    await Promise.all([
      this.chatParticipantModel.create({
        chat: savedChat._id,
        user: new Types.ObjectId(userId),
        hasUnreadMessages: false,
      }),
      this.chatParticipantModel.create({
        chat: savedChat._id,
        user: new Types.ObjectId(createChatDto.participantId),
        hasUnreadMessages: false,
      }),
    ]);

    return this.transformChatToDto(savedChat);
  }

  async getUserChats(userId: string): Promise<{
    directChats: ChatListItemDto[];
    groupChats: ChatListItemDto[];
  }> {
    const chatParticipants = await this.chatParticipantModel
      .find({
        user: new Types.ObjectId(userId),
        isDeleted: false,
      })
      .populate({
        path: 'chat',
        populate: [
          {
            path: 'creator',
            select: 'displayName firstName lastName profilePicture',
          },
          {
            path: 'participants',
            select: 'displayName firstName lastName profilePicture',
          },
          {
            path: 'lastMessage',
            populate: {
              path: 'sender',
              select: 'displayName firstName lastName',
            },
          },
        ],
      });

    const directChats: ChatListItemDto[] = [];
    const groupChats: ChatListItemDto[] = [];

    for (const participant of chatParticipants) {
      if (!participant.chat || (participant.chat as any).isDeleted) {
        continue;
      }

      const chat = participant.chat as any;

      const chatDto: ChatListItemDto = {
        id: chat._id.toString(),
        title: chat.title,
        type: chat.type,
        unreadCount: participant.unreadCount,
        participants: chat.participants.map((p) => ({
          id: p._id?.toString(),
          name: p.displayName || p.firstName || 'User',
          profilePicture: p.profilePicture,
        })),
        creator: {
          id: chat.creator?._id?.toString(),
          name:
            chat.creator?.displayName || chat.creator?.firstName || 'Creator',
        },
      };

      if (chat.lastMessage) {
        chatDto.lastMessage = {
          content: chat.lastMessage.content,
          sender:
            chat.lastMessage.sender?.displayName ||
            chat.lastMessage.sender?.firstName ||
            'User',
          timestamp: chat.lastMessage.createdAt?.toISOString(),
        };
      }

      if (chat.type === ChatType.DIRECT) {
        directChats.push(chatDto);
      } else {
        groupChats.push(chatDto);
      }
    }

    return { directChats, groupChats };
  }

  async getChat(userId: string, chatId: string): Promise<ChatDto> {
    const chatParticipant = await this.chatParticipantModel.findOne({
      chat: new Types.ObjectId(chatId),
      user: new Types.ObjectId(userId),
      isDeleted: false,
    });

    if (!chatParticipant) {
      throw new NotFoundException(
        'Chat not found or you are not a participant',
      );
    }

    const chat = await this.chatModel
      .findById(chatId)
      .populate(
        'creator',
        'displayName firstName lastName profilePicture isCreator',
      )
      .populate(
        'participants',
        'displayName firstName lastName profilePicture isCreator',
      )
      .populate({
        path: 'lastMessage',
        populate: {
          path: 'sender',
          select: 'displayName firstName lastName',
        },
      })
      .populate('accessTiers', 'name');

    if (!chat || chat.isDeleted) {
      throw new NotFoundException('Chat not found');
    }

    const chatDto = this.transformChatToDto(chat);

    chatDto.unreadCount = chatParticipant.unreadCount;

    return chatDto;
  }

  async updateGroupChat(
    userId: string,
    chatId: string,
    updateChatDto: UpdateGroupChatDto,
  ): Promise<ChatDto> {
    const chat = await this.chatModel.findById(chatId);

    if (!chat || chat.isDeleted) {
      throw new NotFoundException('Chat not found');
    }

    if (chat.type !== ChatType.GROUP) {
      throw new BadRequestException(
        'This operation is only available for group chats',
      );
    }

    if (chat.creator.toString() !== userId) {
      throw new ForbiddenException('Only the creator can update the chat');
    }

    if (updateChatDto.accessType === ChatAccessType.SELECTED) {
      if (
        !updateChatDto.accessTiers ||
        updateChatDto.accessTiers.length === 0
      ) {
        throw new BadRequestException(
          'Access tiers must be provided when access type is set to "select"',
        );
      }

      const membershipCount = await this.membershipModel.countDocuments({
        _id: {
          $in: updateChatDto.accessTiers.map((id) => new Types.ObjectId(id)),
        },
        creator: new Types.ObjectId(userId),
      });

      if (membershipCount !== updateChatDto.accessTiers.length) {
        throw new BadRequestException(
          'One or more tiers are invalid or do not belong to this creator',
        );
      }
    }

    const updateData: any = { ...updateChatDto };

    if (updateChatDto.accessTiers) {
      updateData.accessTiers = updateChatDto.accessTiers.map(
        (id) => new Types.ObjectId(id),
      );
    }

    const updatedChat = await this.chatModel
      .findByIdAndUpdate(chatId, { $set: updateData }, { new: true })
      .populate(
        'creator',
        'displayName firstName lastName profilePicture isCreator',
      )
      .populate(
        'participants',
        'displayName firstName lastName profilePicture isCreator',
      )
      .populate({
        path: 'lastMessage',
        populate: {
          path: 'sender',
          select: 'displayName firstName lastName',
        },
      })
      .populate('accessTiers', 'name');

    return this.transformChatToDto(updatedChat);
  }

  async deleteChat(
    userId: string,
    chatId: string,
  ): Promise<{ success: boolean }> {
    const chat = await this.chatModel.findById(chatId);

    if (!chat || chat.isDeleted) {
      throw new NotFoundException('Chat not found');
    }

    if (chat.type === ChatType.GROUP && chat.creator.toString() !== userId) {
      throw new ForbiddenException('Only the creator can delete the chat');
    }

    if (
      chat.type === ChatType.DIRECT &&
      !chat.participants.some((p) => p.toString() === userId)
    ) {
      throw new ForbiddenException('You are not a participant in this chat');
    }

    await this.chatModel.findByIdAndUpdate(chatId, {
      $set: {
        isDeleted: true,
        deletedAt: new Date(),
      },
    });

    await this.chatParticipantModel.updateMany(
      { chat: new Types.ObjectId(chatId) },
      { $set: { isDeleted: true } },
    );

    return { success: true };
  }

  async sendMessage(
    userId: string,
    chatId: string,
    sendMessageDto: SendMessageDto,
    attachmentFile?: Express.Multer.File,
  ): Promise<MessageDto> {
    const chatParticipant = await this.chatParticipantModel.findOne({
      chat: new Types.ObjectId(chatId),
      user: new Types.ObjectId(userId),
      isDeleted: false,
    });

    if (!chatParticipant) {
      throw new NotFoundException(
        'Chat not found or you are not a participant',
      );
    }

    const chat = await this.chatModel.findById(chatId).populate('participants');

    if (!chat || chat.isDeleted) {
      throw new NotFoundException('Chat not found');
    }

    let attachment;
    if (attachmentFile) {
      const fileUrl = await this.s3Service.uploadFile(
        attachmentFile,
        `chats/${chatId}`,
        'patreon-clone-test-dps',
      );

      attachment = {
        url: fileUrl,
        fileName: attachmentFile.originalname,
        fileType: attachmentFile.mimetype,
        fileSize: attachmentFile.size,
        uploadedAt: new Date(),
      };
    }

    const message = new this.messageModel({
      chat: new Types.ObjectId(chatId),
      sender: new Types.ObjectId(userId),
      content: sendMessageDto.content,
      attachments: attachment ? [attachment] : undefined,
      readBy: [new Types.ObjectId(userId)],
    });

    const savedMessage = await message.save();

    await this.chatModel.findByIdAndUpdate(chatId, {
      $set: { lastMessage: savedMessage._id },
    });

    await this.chatParticipantModel.updateMany(
      {
        chat: new Types.ObjectId(chatId),
        user: { $ne: new Types.ObjectId(userId) },
      },
      {
        $set: { hasUnreadMessages: true },
        $inc: { unreadCount: 1 },
      },
    );

    try {
      const otherParticipants = chat.participants.filter(
        (p) => p.toString() !== userId,
      );

      if (this.notificationGenerator && otherParticipants.length > 0) {
        for (const participant of otherParticipants) {
          await this.notificationGenerator.generateChatMessageNotification(
            userId,
            participant.toString(),
            chatId,
            sendMessageDto.content,
          );
        }
      }
    } catch (error) {
      console.error('Failed to generate chat message notifications:', error);
    }

    const populatedMessage = await this.messageModel
      .findById(savedMessage._id)
      .populate(
        'sender',
        'displayName firstName lastName profilePicture isCreator',
      );

    return this.transformMessageToDto(populatedMessage);
  }

  async getMessages(
    userId: string,
    chatId: string,
    query: GetMessagesQueryDto,
  ): Promise<{ messages: MessageDto[]; hasMore: boolean }> {
    const chatParticipant = await this.chatParticipantModel.findOne({
      chat: new Types.ObjectId(chatId),
      user: new Types.ObjectId(userId),
      isDeleted: false,
    });

    if (!chatParticipant) {
      throw new NotFoundException(
        'Chat not found or you are not a participant',
      );
    }

    const chat = await this.chatModel.findById(chatId);
    if (!chat || chat.isDeleted) {
      throw new NotFoundException('Chat not found');
    }

    const filter: any = {
      chat: new Types.ObjectId(chatId),
      isDeleted: false,
    };

    if (query.before) {
      filter._id = { $lt: new Types.ObjectId(query.before) };
    } else if (query.after) {
      filter._id = { $gt: new Types.ObjectId(query.after) };
    }

    const limit = query.limit || 20;

    const messages = await this.messageModel
      .find(filter)
      .sort({ createdAt: query.after ? 1 : -1 })
      .limit(limit + 1)
      .populate(
        'sender',
        'displayName firstName lastName profilePicture isCreator',
      );

    const hasMore = messages.length > limit;

    if (hasMore) {
      messages.pop();
    }

    if (query.after) {
      messages.reverse();
    }

    return {
      messages: messages.map((msg) => this.transformMessageToDto(msg)),
      hasMore,
    };
  }

  async markMessagesAsRead(
    userId: string,
    chatId: string,
    markReadDto: MarkMessagesReadDto,
  ): Promise<{ success: boolean }> {
    const chatParticipant = await this.chatParticipantModel.findOne({
      chat: new Types.ObjectId(chatId),
      user: new Types.ObjectId(userId),
      isDeleted: false,
    });

    if (!chatParticipant) {
      throw new NotFoundException(
        'Chat not found or you are not a participant',
      );
    }

    await this.messageModel.updateMany(
      {
        chat: new Types.ObjectId(chatId),
        _id: { $lte: new Types.ObjectId(markReadDto.lastReadMessageId) },
        readBy: { $ne: new Types.ObjectId(userId) },
      },
      { $addToSet: { readBy: new Types.ObjectId(userId) } },
    );

    await this.chatParticipantModel.findOneAndUpdate(
      {
        chat: new Types.ObjectId(chatId),
        user: new Types.ObjectId(userId),
      },
      {
        $set: {
          hasUnreadMessages: false,
          unreadCount: 0,
          lastReadMessageId: new Types.ObjectId(markReadDto.lastReadMessageId),
        },
      },
    );

    return { success: true };
  }

  async checkChatAccess(userId: string, chatId: string): Promise<boolean> {
    const chat = await this.chatModel.findById(chatId);
    if (!chat || chat.isDeleted) {
      return false;
    }

    if (chat.type === ChatType.DIRECT) {
      return chat.participants.some((p) => p.toString() === userId);
    }

    const user = await this.userModel.findById(userId);
    if (!user) {
      return false;
    }

    if (chat.creator.toString() === userId) {
      return true;
    }

    switch (chat.accessType) {
      case ChatAccessType.ALL:
        return true;

      case ChatAccessType.PAID:
        const subscription = await this.subscriptionModel.findOne({
          subscriber: new Types.ObjectId(userId),
          creator: chat.creator,
          status: 'active',
        });
        return !!subscription;

      case ChatAccessType.SELECTED:
        if (!chat.accessTiers || chat.accessTiers.length === 0) {
          return false;
        }

        const tierSubscription = await this.subscriptionModel.findOne({
          subscriber: new Types.ObjectId(userId),
          creator: chat.creator,
          membership: { $in: chat.accessTiers },
          status: 'active',
        });
        return !!tierSubscription;

      default:
        return false;
    }
  }

  async joinChat(userId: string, chatId: string): Promise<ChatDto> {
    const chat = await this.chatModel.findById(chatId);
    if (!chat || chat.isDeleted) {
      throw new NotFoundException('Chat not found');
    }

    if (chat.type !== ChatType.GROUP) {
      throw new BadRequestException('Only group chats can be joined');
    }

    const existingParticipant = await this.chatParticipantModel.findOne({
      chat: new Types.ObjectId(chatId),
      user: new Types.ObjectId(userId),
      isDeleted: false,
    });

    if (existingParticipant) {
      return this.getChat(userId, chatId);
    }

    const hasAccess = await this.checkChatAccess(userId, chatId);
    if (!hasAccess) {
      throw new ForbiddenException('You do not have access to join this chat');
    }

    await this.chatParticipantModel.create({
      chat: new Types.ObjectId(chatId),
      user: new Types.ObjectId(userId),
      hasUnreadMessages: true,
      unreadCount: 0,
    });

    await this.chatModel.findByIdAndUpdate(chatId, {
      $addToSet: { participants: new Types.ObjectId(userId) },
    });

    return this.getChat(userId, chatId);
  }

  async leaveChat(
    userId: string,
    chatId: string,
  ): Promise<{ success: boolean }> {
    const chat = await this.chatModel.findById(chatId);
    if (!chat || chat.isDeleted) {
      throw new NotFoundException('Chat not found');
    }

    if (chat.type !== ChatType.GROUP) {
      throw new BadRequestException('Only group chats can be left');
    }

    if (chat.creator.toString() === userId) {
      throw new BadRequestException('Creator cannot leave their own chat');
    }

    await this.chatParticipantModel.findOneAndUpdate(
      {
        chat: new Types.ObjectId(chatId),
        user: new Types.ObjectId(userId),
      },
      { $set: { isDeleted: true } },
    );

    await this.chatModel.findByIdAndUpdate(chatId, {
      $pull: { participants: new Types.ObjectId(userId) },
    });

    return { success: true };
  }

  async getTotalUnreadCount(userId: string): Promise<number> {
    const participants = await this.chatParticipantModel.find({
      user: new Types.ObjectId(userId),
      isDeleted: false,
    });

    return participants.reduce(
      (total, participant) => total + (participant.unreadCount || 0),
      0,
    );
  }

  private transformChatToDto(chat: any): ChatDto {
    return {
      id: chat._id.toString(),
      type: chat.type,
      title: chat.title,
      description: chat.description,
      creator: this.transformUserToChatParticipant(chat.creator),
      participants: Array.isArray(chat.participants)
        ? chat.participants.map((p) => this.transformUserToChatParticipant(p))
        : [],
      lastMessage: chat.lastMessage
        ? this.transformMessageToDto(chat.lastMessage)
        : undefined,
      accessType: chat.accessType,
      accessTiers: Array.isArray(chat.accessTiers)
        ? chat.accessTiers.map((tier) => ({
            id: tier._id?.toString() || tier.toString(),
            name: tier.name || 'Unknown Tier',
          }))
        : [],
      createdAt: chat.createdAt?.toISOString() || new Date().toISOString(),
      updatedAt: chat.updatedAt?.toISOString() || new Date().toISOString(),
    };
  }

  private transformMessageToDto(message: any): MessageDto {
    return {
      id: message._id.toString(),
      content: message.content,
      sender: this.transformUserToChatParticipant(message.sender),
      attachments: message.attachments?.map((attachment) => ({
        url: attachment.url,
        fileName: attachment.fileName,
        fileType: attachment.fileType,
        fileSize: attachment.fileSize,
        uploadedAt:
          attachment.uploadedAt?.toISOString() || new Date().toISOString(),
      })),
      createdAt: message.createdAt?.toISOString() || new Date().toISOString(),
      updatedAt: message.updatedAt?.toISOString() || new Date().toISOString(),
      readBy: Array.isArray(message.readBy)
        ? message.readBy.map((id) => id.toString())
        : [],
      isDeleted: !!message.isDeleted,
    };
  }

  private transformUserToChatParticipant(user: any): any {
    if (!user) {
      return {
        id: 'unknown',
        displayName: 'Unknown User',
        isCreator: false,
      };
    }

    return {
      id: user._id?.toString() || user.toString(),
      displayName: user.displayName || user.firstName || 'User',
      profilePicture: user.profilePicture,
      isCreator: !!user.isCreator,
    };
  }
}
