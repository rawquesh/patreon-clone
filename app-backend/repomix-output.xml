!account.payouts_enabled) { if (!account.details_submitted) { actionNeeded.push('complete_onboarding'); } if (account.requirements?.currently_due?.length > 0) { actionNeeded.push('provide_additional_information'); } } return { isEnabled: account.charges_enabled && account.payouts_enabled, requiresAction: actionNeeded.length > 0, actionNeeded: actionNeeded.length > 0 ? actionNeeded : undefined, }; } async generateNewOnboardingLink(userId: string): Promise<string> { const user = await this.userModel.findById(userId); if (!user?.stripeConnectAccountId) { throw new BadRequestException('No Stripe Connect account found'); } const accountLink = await this.stripe.accountLinks.create({ account: user.stripeConnectAccountId, refresh_url: `${this.configService.get('FRONTEND_URL')}/creator/stripe/refresh`, return_url: `${this.configService.get('FRONTEND_URL')}/creator/stripe/complete`, type: 'account_onboarding', collect: 'eventually_due', }); return accountLink.url; } async getPayoutBalance(userId: string): Promise<{ available: number; pending: number; }> { const user = await this.userModel.findById(userId); if (!user?.stripeConnectAccountId) { throw new BadRequestException('No Stripe Connect account found'); } const balance = await this.stripe.balance.retrieve({ stripeAccount: user.stripeConnectAccountId, }); return { available: balance.available.reduce((sum, bal) => sum + bal.amount, 0) / 100, pending: balance.pending.reduce((sum, bal) => sum + bal.amount, 0) / 100, }; } async initiatePayoutToBank(userId: string, amount: number): Promise<void> { const user = await this.userModel.findById(userId); if (!user?.stripeConnectAccountId) { throw new BadRequestException('No Stripe Connect account found'); } await this.stripe.payouts.create( { amount: Math.round(amount * 100), currency: 'usd', }, { stripeAccount: user.stripeConnectAccountId, }, ); } }
