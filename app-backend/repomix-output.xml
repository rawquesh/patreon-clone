  // ... (findPublishedPosts, findPublishedPostsByCreator, filterPostForListing, permanentDelete, like/unlike, comments, etc. remain the same) ...
  async findPublishedPosts(
    fetchPostsDto: FetchPostsDto,
    userId?: string,
    creatorId?: string,
  ): Promise<{
    posts: (Post & {
      isRestrictedView?: boolean;
      previewText?: string;
      thumbnailUrl?: string;
    })[];
    total: number;
  }> {
    const {
      page = 1,
      limit = 10,
      sortBy = SortBy.CREATED_AT,
      sortOrder = SortOrder.DESC,
      types: postTypes,
      tierAccess,
      search,
      collections,
      tags,
      collection,
    } = fetchPostsDto;

    let types;
    if (typeof postTypes === 'string') {
      try {
        types = JSON.parse(postTypes);
      } catch (e) {
        console.log(e);
        types = postTypes ? [postTypes] : undefined;
      }
    } else {
      types = postTypes;
    }

    const skip = (page - 1) * limit;
    const filter: any = {
      status: PostStatus.PUBLISHED,
      isDeleted: false,
      isActive: true,
    };

    if (creatorId) {
      const creator = await this.getCreatorId(creatorId);
      filter.creator = creator;
    }

    if (types?.length) {
      filter.type = { $in: types };
    }

    if (tierAccess?.length) {
      const parsedTierAccess = this.processTags(tierAccess);
      if (parsedTierAccess.length) {
        filter.$or = [
          { tierAccess: { $in: parsedTierAccess } },
          { tierAccess: { $size: 0 } }, // Also include public posts
        ];
      }
    }

    // Handle single collection parameter
    if (collection) {
      try {
        // const collectionId = new Types.ObjectId(collection);
        // filter.collections = collectionId; // MongoDB will match if this ObjectId is in the collections array
        filter.collections = { $in: [String(collection)] };
      } catch (error) {
        console.error('Invalid collection ID format:', error.message);
        // If invalid ID format, use a non-matching query to return empty results
        filter._id = new Types.ObjectId(); // This will never match any post
      }
    } else if (collections?.length) {
      try {
        const parsedCollections = this.processTags(collections);
        const objectIdCollections = parsedCollections
          .map((id) => {
            try {
              return new Types.ObjectId(id);
            } catch (e) {
              console.error(`Invalid collection ID format: ${id}`, e.message);
              return null;
            }
          })
          .filter((id) => id !== null);

        if (objectIdCollections.length > 0) {
          // Find posts where at least one of the IDs in objectIdCollections exists in the post's collections array
          filter.collections = { $in: objectIdCollections };
        }
      } catch (error) {
        console.error('Error processing collections filter:', error.message);
      }
    }

    if (tags?.length) {
      const parsedTags = this.processTags(tags);
      filter.tags = { $in: parsedTags };
    }

    if (search) {
      filter.$text = { $search: search };
    }

    const sort: any = {};
    sort[sortBy] = sortOrder === SortOrder.ASC ? 1 : -1;
    console.log(filter);

    const delFilter = {
      // status: 'published',
      // isDeleted: false,
      // isActive: true,
      // creator: new Types.ObjectId('67e047959641ed3a7f063b9d'),
      collections: { $in: [new Types.ObjectId('67f10f8db75317a6141a144f')] },
      // collections: new Types.ObjectId('67f10f8db75317a6141a144f'),
    };
    const [posts, total] = await Promise.all([
      this.postModel
        .find(filter)
        .populate(
          'creator',
          'displayName profilePicture creatorUsername type status',
        )
        .sort(sort)
        .skip(skip)
        .limit(limit)
        .exec(),
      this.postModel.countDocuments(filter),
    ]);
    console.log(posts);

    const postsWithRestrictedContent = await Promise.all(
      posts.map(async (post) => {
        const hasAccess = await this.checkPostAccess(userId, post); // Use checkPostAccess
        return this.filterPostForListing(post, hasAccess);
      }),
    );
    return { posts: postsWithRestrictedContent, total };
  }

