import {
  Controller,
  Post,
  Get,
  Body,
  UseGuards,
  Request,
  BadRequestException,
} from '@nestjs/common';
import { AuthGuard } from '@nestjs/passport';
import { PaymentsService } from './payments.service';

@Controller('payments')
@UseGuards(AuthGuard('jwt'))
export class PaymentsController {
  constructor(private readonly paymentsService: PaymentsService) {}

  @Get('balance')
  async getBalance(@Request() req) {
    try {
      return await this.paymentsService.getPayoutBalance(req.user.userId);
    } catch (error) {
      throw new BadRequestException(error.message);
    }
  }

  @Get('connect/status')
  async getConnectAccountStatus(@Request() req) {
    try {
      return await this.paymentsService.getConnectAccountStatus(
        req.user.userId,
      );
    } catch (error) {
      throw new BadRequestException(error.message);
    }
  }

  @Post('connect/refresh-link')
  async refreshOnboardingLink(@Request() req) {
    try {
      const onboardingUrl =
        await this.paymentsService.generateNewOnboardingLink(req.user.userId);
      return { onboardingUrl };
    } catch (error) {
      throw new BadRequestException(error.message);
    }
  }

  @Post('payout')
  async createPayout(@Request() req, @Body('amount') amount: number) {
    if (!amount || amount <= 0) {
      throw new BadRequestException('Invalid payout amount');
    }

    try {
      await this.paymentsService.initiatePayoutToBank(req.user.userId, amount);
      return { message: 'Payout initiated successfully' };
    } catch (error) {
      throw new BadRequestException(error.message);
    }
  }
}
