import { Injectable } from '@nestjs/common'; import { InjectModel } from '@nestjs/mongoose'; import { Model } from 'mongoose'; import { User } from '@/schemas/users.schema'; import { Post } from '@/schemas/posts.schema'; import { CreatorStatus } from '@/schemas/users.schema'; @Injectable() export class SearchService { constructor( @InjectModel(User.name) private userModel: Model<User>, @InjectModel(Post.name) private postModel: Model<Post>, ) {} async search(query: string) { const [creators, topics] = await Promise.all([ this.searchCreators(query), this.searchTopics(query), ]); return { creators, topics, }; } async searchCreators(query: string) { const creators = await this.userModel .find({ $and: [ { isCreator: true }, { creatorStatus: CreatorStatus.PUBLISHED }, { $or: [ { displayName: { $regex: query, $options: 'i' } }, { creatorUsername: { $regex: query, $options: 'i' } }, { creatorHeadline: { $regex: query, $options: 'i' } }, ], }, ], }) .select('_id displayName creatorUsername profilePicture creatorHeadline') .limit(10); return creators; } async searchTopics(query: string) { // First, find posts with matching tags const posts = await this.postModel .find({ tags: { $regex: query, $options: 'i' }, isDeleted: false, }) .select('tags') .limit(100); // Extract all tags from the results const allTags = posts.flatMap((post) => post.tags); // Filter tags that match the query const matchingTags = allTags.filter((tag) => tag.toLowerCase().includes(query.toLowerCase()), ); // Remove duplicates and limit the number of results const uniqueTags = [...new Set(matchingTags)].slice(0, 10); return uniqueTags; } }
