import { Injectable } from '@nestjs/common';
import { NotificationsService } from './notifications.service';
import { NotificationType } from '@/schemas/notifications.schema';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { Subscription } from '@/schemas/subscribers.schema';

@Injectable()
export class NotificationGeneratorService {
  constructor(
    private readonly notificationsService: NotificationsService,
    @InjectModel(Subscription.name)
    private subscriptionModel: Model<Subscription>,
  ) {}

  async generateLikeNotification(
    postId: string,
    actorId: string,
    recipientId: string,
  ): Promise<void> {
    if (actorId === recipientId) return;

    await this.notificationsService.create({
      recipient: recipientId,
      actor: actorId,
      type: NotificationType.LIKE,
      post: postId,
    });
  }

  async generateCommentNotification(
    postId: string,
    actorId: string,
    recipientId: string,
    comment: string,
  ): Promise<void> {
    if (actorId === recipientId) return;

    await this.notificationsService.create({
      recipient: recipientId,
      actor: actorId,
      type: NotificationType.COMMENT,
      post: postId,
      comment,
    });
  }

  async generateNewMemberNotification(
    subscriberId: string,
    creatorId: string,
    membershipTier: string,
  ): Promise<void> {
    await this.notificationsService.create({
      recipient: creatorId,
      actor: subscriberId,
      type: NotificationType.NEW_MEMBER,
      comment: `Subscribed to ${membershipTier} tier`,
    });
  }

  async generateUpgradeNotification(
    subscriberId: string,
    creatorId: string,
    newTier: string,
    previousTier: string,
  ): Promise<void> {
    await this.notificationsService.create({
      recipient: creatorId,
      actor: subscriberId,
      type: NotificationType.UPGRADE,
      comment: `Upgraded from ${previousTier} to ${newTier} tier`,
    });
  }

  async generateDowngradeNotification(
    subscriberId: string,
    creatorId: string,
    newTier: string,
    previousTier: string,
  ): Promise<void> {
    await this.notificationsService.create({
      recipient: creatorId,
      actor: subscriberId,
      type: NotificationType.DOWNGRADE,
      comment: `Downgraded from ${previousTier} to ${newTier} tier`,
    });
  }

  async generateCancellationNotification(
    subscriberId: string,
    creatorId: string,
    tier: string,
  ): Promise<void> {
    await this.notificationsService.create({
      recipient: creatorId,
      actor: subscriberId,
      type: NotificationType.CANCELLATION,
      comment: `Cancelled subscription to ${tier} tier`,
    });
  }

  // New notification methods for users

  async generateNewPostNotification(
    creatorId: string,
    postId: string,
    postTitle: string,
  ): Promise<void> {
    // Find all active subscribers for this creator
    const subscribers = await this.subscriptionModel.find({
      creator: creatorId,
      status: 'active',
    });

    // Create a notification for each subscriber
    for (const subscriber of subscribers) {
      await this.notificationsService.create({
        recipient: subscriber.subscriber.toString(),
        actor: creatorId,
        type: NotificationType.NEW_POST,
        post: postId,
        comment: `Published a new post: ${postTitle}`,
      });
    }
  }

  async generateCommentReplyNotification(
    postId: string,
    commentId: string,
    actorId: string,
    parentCommentUserId: string,
    replyText: string,
  ): Promise<void> {
    if (actorId === parentCommentUserId) return;

    await this.notificationsService.create({
      recipient: parentCommentUserId,
      actor: actorId,
      type: NotificationType.COMMENT_REPLY,
      post: postId,
      comment: replyText,
      metadata: { commentId },
    });
  }

  async generateChatMessageNotification(
    senderId: string,
    recipientId: string,
    chatId: string,
    messageContent: string,
  ): Promise<void> {
    if (senderId === recipientId) return;

    await this.notificationsService.create({
      recipient: recipientId,
      actor: senderId,
      type: NotificationType.CHAT_MESSAGE,
      comment:
        messageContent.substring(0, 100) +
        (messageContent.length > 100 ? '...' : ''),
      metadata: { chatId },
    });
  }
}

