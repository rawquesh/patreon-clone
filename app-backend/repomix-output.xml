  ) {}

  @Get()
  @UseGuards(AuthGuard('jwt'))
  async getMyCollections(@Request() req) {
    try {
      const collections = await this.collectionsService.findByCreator(
        req.user.userId,
      );

      return {
        collections,
        total: collections.length,
      };
    } catch (error) {
      throw new BadRequestException(
        `Failed to fetch collections: ${error.message}`,
      );
    }
  }

  @Get('by-creator/:creatorId')
  async getCollectionsByCreator(@Param('creatorId') creatorId: string) {
    try {
      const collections =
        await this.collectionsService.findByCreator(creatorId);

      return {
        collections,
        total: collections.length,
      };
    } catch (error) {
      throw new BadRequestException(
        `Failed to fetch collections: ${error.message}`,
      );
    }
  }

  @Get('creator/:creatorId')
  async getCreatorCollections(@Param('creatorId') creatorId: string) {
    try {
      const collections =
        await this.collectionsService.findByCreator(creatorId);

      const formattedCollections = collections.map((collection) => ({
        id: collection._id.toString(),
        title: collection.title,
        description: collection.description || '',
        coverImage: collection.coverImage,
        postCount: collection.postCount,
        createdAt: collection.createdAt,
      }));

      return {
        collections: formattedCollections,
        total: collections.length,
      };
    } catch (error) {
      throw new BadRequestException(
        `Failed to fetch creator collections: ${error.message}`,
      );
    }
  }

  @Get(':id')
  async getCollectionDetails(
    @Param('id') collectionId: string,
    @Query() fetchPostsDto: FetchPostsDto,
    @Request() req,
  ) {
    try {
      // First, fetch the collection details
      const collection = await this.collectionsService.findById(collectionId);

      if (!collection) {
        throw new NotFoundException('Collection not found');
      }

      const userId = req.user?.userId;

      // Then, fetch posts from this collection
      // We'll reuse the FetchPostsDto but override the collection parameter
      const postsQuery = {
        ...fetchPostsDto,
        collection: collectionId, // Ensure we're filtering by this collection
      };

      // The correct order of arguments for findPublishedPosts is:
      // (fetchPostsDto, userId, creatorId)
      console.log('creator', collection.creator._id);
      const { posts, total } = await this.postsService.findPublishedPosts(
        postsQuery,
        userId,
        collection.creator._id.toString(),
      );
      console.log('posts', posts);
      // Rest of the method remains the same
      const transformedPosts = await Promise.all(
        posts.map(async (post) => {
          try {
            const hasAccess = await this.postsService.checkPostAccess(
              userId,
              post,
            );

            const postObj =
              post instanceof Object && typeof post.toObject === 'function'
                ? post.toObject()
                : { ...post };

            let previewText = '';
            if (postObj.textContent) {
              previewText =
                postObj.textContent.substring(0, 150) +
                (postObj.textContent.length > 150 ? '...' : '');
            } else if (postObj.description) {
              previewText = postObj.description;
            }

            let thumbnail = postObj.thumbnailUrl;
            if (
              !thumbnail &&
              postObj.mediaUrls &&
              postObj.mediaUrls.length > 0
            ) {
              thumbnail = postObj.mediaUrls[0];
            }

            const creator = postObj.creator || {};

            const formattedPost = {
              ...postObj,
              id: postObj._id?.toString(),
              previewText,
              thumbnail,
              creator: {
                id: creator._id?.toString() || '',
                displayName:
                  creator.displayName || creator.creatorUsername || 'Unknown',
                profilePicture: creator.profilePicture,
                username: creator.creatorUsername || '',
                category: creator.creatorCategory || '',
              },
              likesCount: postObj.likeCount || 0,
              commentsCount: postObj.commentCount || 0,
              publishDate: this.postsService.formatDate(postObj.createdAt),
              postType: this.postsService.getReadablePostType(postObj.type),
              isRestrictedView: !hasAccess,
            };

            if (!hasAccess) {
              return this.postsService.filterPostContent(formattedPost, false);
            }

            return formattedPost;
          } catch (error) {
            console.error(`Error processing post ${post.id}:`, error);
            return {};
          }
        }),
      );

      return {
        collection: {
          id: collection._id.toString(),
          title: collection.title,
          description: collection.description,
          coverImage: collection.coverImage,
          postCount: total, // Use actual count from query rather than the stored count
          createdAt: collection.createdAt,
          creator: {
            id:
              collection.creator._id?.toString() ||
              collection.creator.toString(),
            // If creator details are populated, include them
            ...(collection.creator.displayName && {
              displayName: collection.creator.displayName,
              profilePicture: collection.creator.profilePicture,
              username: collection.creator.creatorUsername,
            }),
          },
        },
        posts: transformedPosts,
        pagination: {
          total,
          page: fetchPostsDto.page || 1,
          limit: fetchPostsDto.limit || 10,
          totalPages: Math.ceil(total / (fetchPostsDto.limit || 10)),
        },
      };
    } catch (error) {
      if (error instanceof NotFoundException) {
        throw error;
      }
      throw new BadRequestException(
        `Failed to fetch collection: ${error.message}`,
      );
    }
  }

  @Post()
  @UseGuards(AuthGuard('jwt'))
  @UseInterceptors(
    FileInterceptor('coverImage', {
      limits: {
        fileSize: 2 * 1024 * 1024,
      },
      fileFilter: (req, file, cb) => {
        if (!file.originalname.match(/\.(jpg|jpeg|png|gif)$/)) {
          return cb(
            new BadRequestException('Only image files are allowed!'),
            false,
          );
        }
        cb(null, true);
      },
    }),
  )
  async create(
    @Request() req,
    @Body() createCollectionDto: CreateCollectionDto,
    @UploadedFile() coverImage?: Express.Multer.File,
  ) {
    let coverImageUrl: string | undefined;

    if (coverImage) {
      try {
        coverImageUrl = await this.s3Service.uploadFile(
          coverImage,
          'collections',
          'patreon-clone-collections',
        );
      } catch (error) {
        throw new BadRequestException(
          `Failed to upload cover image: ${error.message}`,
        );
      }
    }

    return this.collectionsService.create(
      req.user.userId,
      createCollectionDto,
      coverImageUrl,
    );
  }
}

