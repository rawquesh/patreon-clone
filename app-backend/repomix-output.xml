            );
          results.push({
            id: updated._id.toString(),
            name: updated.name,
            success: true,
            stripeProductId: updated.stripeProductId,
            stripePriceId: updated.stripePriceId,
          });
        } catch (error) {
          results.push({
            id: membership._id.toString(),
            name: membership.name,
            success: false,
            error: error.message,
          });
        }
      }

      return {
        processed: results.length,
        results,
      };
