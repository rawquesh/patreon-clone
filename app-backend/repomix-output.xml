eSubscriptions.forEach((sub) => { const membership = sub.membership; if (!membership) return; const tierName = membership.name; if (!tierBreakdown[tierName]) { tierBreakdown[tierName] = { count: 0, growth: 0, }; } tierBreakdown[tierName].count++; }); for (const [tierName, data] of Object.entries(tierBreakdown)) { const tierInfo = data as any; const sevenDaysAgo = new Date(today); sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7); const prevInsight = await this.membershipInsightModel .findOne({ creator: creator._id, date: { $lte: sevenDaysAgo }, 'tierBreakdown.tierName': tierName, }) .sort({ date: -1 }); if (prevInsight && prevInsight.tierBreakdown[tierName]) { const prevCount = prevInsight.tierBreakdown[tierName].count; if (prevCount > 0) { tierInfo.growth = Math.round( ((tierInfo.count - prevCount) / prevCount) * 100, ); } } } await this.membershipInsightModel.create({ creator: creator._id, date: today, activeMembers: activeSubscriptions.length, newMembers: newSubscriptions.length, upgradedMembers: Math.round(newSubscriptions.length * 0.7), cancelledMembers: cancelledSubscriptions.length, tierBreakdown, }); } this.logger.log('Completed recording daily membership insights'); } catch (error) { this.logger.error( `Error recording membership insights: ${error.message}`, error.stack, ); } } @Cron(CronExpression.EVERY_DAY_AT_MIDNIGHT) async recordDailyEarningsInsights() { this.logger.log('Recording daily earnings insights'); try { const creators = await this.userModel.find({ isCreator: true }); const today = new Date(); today.setHours(0, 0, 0, 0); const firstDayOfMonth = new Date( today.getFullYear(), today.getMonth(), 1, ); if (today.getDate() !== 1) { this.logger.log('Skipping earnings recording - not first day of month'); return; } for (const creator of creators) { const existingInsight = await this.earningsInsightModel.findOne({ creator: creator._id, date: { $gte: firstDayOfMonth }, }); if (existingInsight) { continue; } const prevMonth = new Date(firstDayOfMonth); prevMonth.setMonth(prevMonth.getMonth() - 1); const prevMonthEnd = new Date(firstDayOfMonth); prevMonthEnd.setDate(prevMonthEnd.getDate() - 1); const subscriptions = await this.subscriptionModel .find({ creator: creator._id, $or: [ { status: 'active', createdAt: { $lt: prevMonthEnd }, }, { status: 'cancelled', createdAt: { $lt: prevMonthEnd }, cancelledAt: { $gt: prevMonth }, }, ], }) .populate('membership'); let totalEarnings = 0; let membershipEarnings = 0; const oneTimeEarnings = 0; const tierBreakdown = {}; subscriptions.forEach((sub) => { if (!sub.membership) return; let earnings = sub.monthlyRate; if (sub.createdAt > prevMonth) { // Partial month - prorate const daysInMonth = new Date( prevMonthEnd.getFullYear(), prevMonthEnd.getMonth() + 1, 0, ).getDate(); const daysActive = Math.min( prevMonthEnd.getDate() - new Date(sub.createdAt).getDate() + 1, daysInMonth, ); earnings = (sub.monthlyRate / daysInMonth) * daysActive; } if (sub.status === 'cancelled' && sub.cancelledAt < prevMonthEnd) { const daysInMonth = new Date( prevMonthEnd.getFullYear(), prevMonthEnd.getMonth() + 1, 0, ).getDate(); const daysActive = new Date(sub.cancelledAt).getDate(); earnings = (sub.monthlyRate / daysInMonth) * daysActive; } totalEarnings += earnings; membershipEarnings += earnings; const tierName = (sub.membership as any).name; if (!tierBreakdown[tierName]) { tierBreakdown[tierName] = { amount: 0, percentage: 0, }; } tierBreakdown[tierName].amount += earnings; }); Object.values(tierBreakdown).forEach((tier: any) => { tier.percentage = Math.round((tier.amount / totalEarnings) * 100); }); await this.earningsInsightModel.create({ creator: creator._id, date: firstDayOfMonth, totalEarnings, membershipEarnings, oneTimeEarnings, tierBreakdown, }); } this.logger.log('Completed recording monthly earnings insights'); } catch (error) { this.logger.error( `Error recording earnings insights: ${error.message}`, error.stack, ); } } @Cron(CronExpression.EVERY_HOUR) async recordHourlyPostInsights() {