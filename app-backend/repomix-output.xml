  async updateMembership(
    @Request() req,
    @Param('id') id: string,
    @Body() updateMembershipDto: UpdateMembershipDto,
    @UploadedFile(
      new ParseFilePipe({
        validators: [
          new MaxFileSizeValidator({ maxSize: 5 * 1024 * 1024 }),
          new FileTypeValidator({ fileType: /(jpg|jpeg|png|gif)$/ }),
