import { Injectable, NotFoundException } from '@nestjs/common'; import { InjectModel } from '@nestjs/mongoose'; import { Model, Types } from 'mongoose'; import { Notification } from '@/schemas/notifications.schema'; import { User } from '@/schemas/users.schema'; import { Post } from '@/schemas/posts.schema'; import { CreateNotificationDto, NotificationFilterDto, NotificationResponseDto, NotificationActorDto, NotificationPostDto, CommentDto, } from './notifications.dto'; @Injectable() export class NotificationsService { constructor( @InjectModel(Notification.name) private notificationModel: Model<Notification>, @InjectModel(User.name) private userModel: Model<User>, @InjectModel(Post.name) private postModel: Model<Post>, ) {} async create( createNotificationDto: CreateNotificationDto, ): Promise<Notification> { const { recipient, actor, type, post, comment } = createNotificationDto; const [recipientUser, actorUser] = await Promise.all([ this.userModel.findById(recipient), this.userModel.findById(actor), ]); if (!recipientUser || !actorUser) { throw new NotFoundException('User not found'); } if (post) { const postDoc = await this.postModel.findById(post); if (!postDoc) { throw new NotFoundException('Post not found'); } } const notification = new this.notificationModel({ recipient: new Types.ObjectId(recipient), actor: new Types.ObjectId(actor), type, post: post ? new Types.ObjectId(post) : undefined, comment: comment ? { content: comment } : undefined, isRead: false, }); return notification.save(); } async findAllForUser( userId: string, filter?: NotificationFilterDto, ): Promise<{ notifications: NotificationResponseDto[]; unreadCount: number; }> { const queryFilter: any = { recipient: new Types.ObjectId(userId) }; const page = filter?.page || 1; const limit = filter?.limit || 10; const skip = (page - 1) * limit; if (filter) { if (filter.unreadOnly) { queryFilter.isRead = false; } if (filter.type && filter.type.length > 0) { queryFilter.type = { $in: filter.type }; } } const [notifications, unreadCount] = await Promise.all([ this.notificationModel .find(queryFilter) .sort({ createdAt: -1 }) .skip(skip) .limit(limit) .populate('actor', 'displayName firstName lastName profilePicture') .populate('post', 'title mediaUrls thumbnailUrl') .exec(), this.notificationModel.countDocuments({ recipient: new Types.ObjectId(userId), isRead: false, }), ]); const transformedNotifications = notifications.map((notification) => this.transformNotification(notification), ); return { notifications: transformedNotifications, unreadCount, }; } async markAsRead( userId: string, notificationIds: string[], ): Promise<boolean> { const objectIds = notificationIds.map((id) => new Types.ObjectId(id)); const result = await this.notificationModel.updateMany( { _id: { $in: objectIds }, recipient: new Types.ObjectId(userId), }, { $set: { isRead: true, readAt: new Date(), }, }, ); return result.modifiedCount > 0; } async markAllAsRead(userId: string): Promise<boolean> { const result = await this.notificationModel.updateMany( { recipient: new Types.ObjectId(userId), isRead: false, }, { $set: { isRead: true, readAt: new Date(), }, }, ); return result.modifiedCount > 0; } async getUnreadCount(userId: string): Promise<number> { return this.notificationModel.countDocuments({ recipient: new Types.ObjectId(userId), isRead: false, }); } async deleteNotification( userId: string, notificationId: string, ): Promise<boolean> { const result = await this.notificationModel.deleteOne({ _id: new Types.ObjectId(notificationId), recipient: new Types.ObjectId(userId), }); if (result.deletedCount === 0) { throw new NotFoundException( 'Notification not found or you do not have permission to delete it', ); } return result.deletedCount > 0; } private transformNotification(notification: any): NotificationResponseDto { const actor = notification.actor as User; const post = notification.post as Post; const actorData: NotificationActorDto = { id: actor?._id?.toString() || '', name: actor?.displayName || actor?.firstName || 'User', profilePicture: actor?.profilePicture || '', }; let postData: NotificationPostDto | undefined = undefined; if (post) { postData = { id: post._id?.toString(), title: post.title || '', thumbnailUrl: this.getPostThumbnail(post), }; } let commentData: CommentDto | undefined = undefined; if (notification.comment) { commentData = { content: notification.comment.content || '', }; } return { id: notification._id.toString(), actor: actorData, type: notification.type, post: postData, comment: commentData, isRead: notification.isRead, createdAt: notification.createdAt.toISOString(), timeStamp: notification.createdAt.toISOString(), }; } private getPostThumbnail(post: Post): string { if (!post) return '/default-thumbnail.png'; if (post.thumbnailUrl) { return post.thumbnailUrl; } if (post.mediaUrls && post.mediaUrls.length > 0) { return post.mediaUrls[0]; } return '/default-thumbnail.png'; } }
