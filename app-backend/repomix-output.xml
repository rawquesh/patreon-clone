```ts
import { MembershipsService } from '@/memberships/memberships.service';
import { PaymentsService } from '@/payments/payments.service';
import {
  BadRequestException,
  Controller,
  Headers,
  Post,
  Req,
  Logger,
} from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { Request } from 'express';

@Controller('webhooks/stripe')
export class StripeWebhookController {
  private readonly logger = new Logger(StripeWebhookController.name);

  constructor(
    private readonly membershipsService: MembershipsService,
    private configService: ConfigService,
    private paymentsService: PaymentsService,
  ) {}

  @Post()
  async handleStripeWebhook(
    @Req() request: Request,
    @Headers('stripe-signature') signature: string,
  ) {
    this.logger.log('Received Stripe webhook request');
    this.logger.log(`Headers: ${JSON.stringify(request.headers)}`);

    if (!signature) {
      this.logger.error('Missing stripe-signature header');
      throw new BadRequestException('Missing stripe-signature header');
    }

    this.logger.log(
      `Stripe signature received: ${signature.substring(0, 10)}...`,
    );

    // Check for webhook secret
    const webhookSecret = this.configService.get('STRIPE_WEBHOOK_SECRET');

    if (!webhookSecret) {
      this.logger.error(
        'Missing STRIPE_WEBHOOK_SECRET in environment variables',
      );
      this.logger.log('Available env vars:', Object.keys(process.env));
      throw new BadRequestException('Webhook secret not configured');
    }

    this.logger.log('Webhook secret found');

    // Access the raw body that was attached by the middleware in main.ts
    const rawBody = (request as any).rawBody;

    if (!rawBody) {
      this.logger.error('No raw body found on request');
      this.logger.log(
        `Request properties: ${JSON.stringify(Object.keys(request))}`,
      );
      throw new BadRequestException('No raw body found on request');
    }

    this.logger.log(
      `Raw body type: ${typeof rawBody}, length: ${rawBody.length || (rawBody.toString ? rawBody.toString().length : 'unknown')}`,
    );

    let event;
    try {
      // Verify the signature using the raw body
      this.logger.log('Attempting to verify webhook signature');
      event = this.paymentsService.stripe.webhooks.constructEvent(
        rawBody,
        signature,
        webhookSecret,
      );
      this.logger.log('Signature verification successful');
    } catch (err) {
      this.logger.error(
        `Webhook signature verification failed: ${err.message}`,
      );
      this.logger.error(`Error stack: ${err.stack}`);
      throw new BadRequestException(
        `Webhook signature verification failed: ${err.message}`,
      );
    }

    this.logger.log(`Processing webhook event: ${event.type}, id: ${event.id}`);

    try {
      switch (event.type) {
        case 'checkout.session.completed':
          this.logger.log('Handling checkout.session.completed event');
          await this.handleCheckoutSessionCompleted(event.data.object);
          break;
        case 'customer.subscription.created':
          this.logger.log('Handling customer.subscription.created event');
          await this.handleSubscriptionCreated(event.data.object);
          break;
        case 'customer.subscription.updated':
          this.logger.log('Handling customer.subscription.updated event');
          await this.handleSubscriptionUpdated(event.data.object);
          break;
        case 'customer.subscription.deleted':
          this.logger.log('Handling customer.subscription.deleted event');
          await this.handleSubscriptionDeleted(event.data.object);
          break;
        case 'invoice.paid':
          this.logger.log('Handling invoice.paid event');
          await this.handleInvoicePaid(event.data.object);
          break;
        default:
          this.logger.log(`Unhandled event type: ${event.type}`);
      }
      this.logger.log(`Successfully processed webhook event: ${event.type}`);
    } catch (error) {
      this.logger.error(
        `Error handling webhook ${event.type}: ${error.message}`,
      );
      this.logger.error(`Error stack: ${error.stack}`);
    }

    this.logger.log('Webhook processing completed');
    return { received: true };
  }

  private async handleCheckoutSessionCompleted(session: any) {
    this.logger.log(`Checkout session completed: ${session.id}`);
    this.logger.log(`Session details: ${JSON.stringify(session, null, 2)}`);

    try {
      // Check if this is a subscription checkout
      if (session.mode === 'subscription' && session.subscription) {
        this.logger.log(`Subscription created: ${session.subscription}`);

        // Retrieve the subscription to get more details
        const subscription =
          await this.paymentsService.stripe.subscriptions.retrieve(
            session.subscription,
          );

        this.logger.log(`Retrieved subscription details: ${subscription.id}`);

        // Get the membership and subscriber info from metadata
        const metadata = session.metadata || {};
        this.logger.log(`Session metadata: ${JSON.stringify(metadata)}`);

        const { membershipId, subscriberId } = metadata;

        if (!membershipId || !subscriberId) {
          this.logger.warn(
            `Missing required metadata in checkout session: ${session.id}`,
          );
          return;
        }

        this.logger.log(
          `Creating subscription for: memberId=${membershipId}, subscriberId=${subscriberId}`,
        );

        // Create the subscription in our system
        // Get the price information from the subscription items
        const subscriptionItem = subscription.items.data[0];
        const priceAmount = subscriptionItem?.price?.unit_amount || 0;

        this.logger.log(`Subscription price amount: ${priceAmount}`);

        await this.membershipsService.createSubscriptionFromStripe(
          subscriberId,
          membershipId,
          subscription.id,
          {
            currentPeriodStart: subscription.current_period_start,
            currentPeriodEnd: subscription.current_period_end,
            monthlyRate: priceAmount / 100,
            status: subscription.status,
          },
        );

        this.logger.log(
          'Successfully created subscription from checkout session',
        );
      } else {
        this.logger.log(
          `Checkout session is not for a subscription: mode=${session.mode}`,
        );
      }
    } catch (error) {
      this.logger.error(`Error processing checkout session: ${error.message}`);
      this.logger.error(`Error stack: ${error.stack}`);
    }
  }

  private async handleSubscriptionCreated(subscription: any) {
    try {
      this.logger.log(`Subscription created: ${subscription.id}`);

      const metadata = subscription.metadata || {};
      this.logger.log(`Subscription metadata: ${JSON.stringify(metadata)}`);

      const { membershipId, subscriberId } = metadata;

      if (!membershipId || !subscriberId) {
        this.logger.warn(
          `Missing required metadata in subscription: ${subscription.id}`,
        );
        return;
      }

      this.logger.log(
        `Creating subscription from Stripe: memberId=${membershipId}, subscriberId=${subscriberId}`,
      );

      // Get the price information from the subscription items
      const subscriptionItem = subscription.items.data[0];
      const priceAmount = subscriptionItem?.price?.unit_amount || 0;

      this.logger.log(`Subscription price amount: ${priceAmount}`);

      await this.membershipsService.createSubscriptionFromStripe(
        subscriberId,
        membershipId,
        subscription.id,
        {
          currentPeriodStart: subscription.current_period_start,
          currentPeriodEnd: subscription.current_period_end,
          monthlyRate: priceAmount / 100,
          status: subscription.status,
        },
      );

      this.logger.log('Successfully created subscription from Stripe webhook');
    } catch (error) {
      this.logger.error(
        `Error creating subscription from webhook: ${error.message}`,
      );
      this.logger.error(`Error stack: ${error.stack}`);
    }
  }

  private async handleSubscriptionUpdated(subscription: any) {
    try {
      this.logger.log(`Subscription updated: ${subscription.id}`);

      const metadata = subscription.metadata || {};
      this.logger.log(`Subscription metadata: ${JSON.stringify(metadata)}`);

      const { membershipId, subscriberId } = metadata;

      if (!membershipId || !subscriberId) {
        this.logger.warn('Missing required metadata for subscription update');
        return;
      }

      this.logger.log(
        `Updating subscription from Stripe: memberId=${membershipId}, subscriberId=${subscriberId}`,
      );

      await this.membershipsService.updateSubscriptionFromStripe(
        subscriberId,
        membershipId,
        subscription.id,
        {
          status: subscription.status,
          currentPeriodEnd: subscription.current_period_end,
          cancelledAt: subscription.canceled_at,
        },
      );

      this.logger.log('Successfully updated subscription from Stripe webhook');
    } catch (error) {
      this.logger.error(
        `Error updating subscription from webhook: ${error.message}`,
      );
      this.logger.error(`Error stack: ${error.stack}`);
    }
  }

  private async handleSubscriptionDeleted(subscription: any) {
    try {
      this.logger.log(`Subscription deleted: ${subscription.id}`);

      this.logger.log('Looking up subscription in database');
      const dbSubscription =
        await this.membershipsService.findSubscriptionByStripeId(
          subscription.id,
        );

      if (dbSubscription) {
        this.logger.log(
          `Found subscription in DB: ${dbSubscription._id.toString()}`,
        );

        await this.membershipsService.markSubscriptionAsExpired(
          dbSubscription._id.toString(),
        );

        this.logger.log('Successfully marked subscription as expired');
      } else {
        this.logger.warn(
          `Subscription not found in database: ${subscription.id}`,
        );
      }
    } catch (error) {
      this.logger.error(
        `Error handling subscription deleted webhook: ${error.message}`,
      );
      this.logger.error(`Error stack: ${error.stack}`);
    }
  }

  private async handleInvoicePaid(invoice: any) {
    try {
      this.logger.log(
        `Invoice paid: ${invoice.id}, amount: ${invoice.amount_paid}`,
      );

      if (invoice.subscription && invoice.status === 'paid') {
        this.logger.log(`Retrieving subscription: ${invoice.subscription}`);

        const subscription =
          await this.paymentsService.stripe.subscriptions.retrieve(
            invoice.subscription,
          );

        const metadata = subscription.metadata || {};
        this.logger.log(`Subscription metadata: ${JSON.stringify(metadata)}`);

        const { membershipId, subscriberId, creatorId } = metadata;

        if (!membershipId || !subscriberId || !creatorId) {
          this.logger.warn('Missing required metadata for invoice processing');
          return;
        }

        this.logger.log(`Getting membership details for: ${membershipId}`);
        // const membership =
        //   await this.membershipsService.getMembershipById(membershipId);

        const amountPaid = invoice.amount_paid / 100;
        this.logger.log(`Amount paid: ${amountPaid}`);

        const creatorShare =
          this.membershipsService.calculateCreatorShare(amountPaid);
        this.logger.log(`Creator share: ${creatorShare}`);

        this.logger.log(`Crediting creator ${creatorId} with ${creatorShare}`);
        await this.membershipsService.creditCreatorForPayment(
          creatorId,
          creatorShare,
        );

        this.logger.log(
          `Updating subscription period to ${subscription.current_period_end}`,
        );
        await this.membershipsService.updateSubscriptionPeriod(
          subscriberId,
          membershipId,
          subscription.current_period_end,
        );

        this.logger.log('Successfully processed invoice payment');
      } else {
        this.logger.log('Invoice not associated with subscription or not paid');
      }
    } catch (error) {
      this.logger.error(
        `Error handling invoice paid webhook: ${error.message}`,
      );
      this.logger.error(`Error stack: ${error.stack}`);
    }
  }
}

