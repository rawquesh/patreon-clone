ail', title: 'Email' }, { id: 'tier', title: 'Membership Tier' }, { id: 'joinDate', title: 'Join Date' }, { id: 'status', title: 'Status' }, { id: 'totalPaid', title: 'Total Paid' }, ], }); const csvString = csvStringifier.getHeaderString() + csvStringifier.stringifyRecords(csvData); res.setHeader('Content-Type', 'text/csv'); res.setHeader('Content-Disposition', 'attachment; filename=members.csv'); return res.send(csvString); } catch (error) { if (error instanceof NotFoundException) { throw error; } throw new BadRequestException( `Failed to export members: ${error.message}`, ); } } }
