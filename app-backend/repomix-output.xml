import { Controller, Put, Body, UseGuards, Req, UploadedFile, UseInterceptors, ParseFilePipe, MaxFileSizeValidator, FileTypeValidator, BadRequestException, Post, Request, UnauthorizedException, Get, } from '@nestjs/common'; import { FileInterceptor } from '@nestjs/platform-express'; import { AuthGuard } from '@nestjs/passport'; import { UsersService } from './users.service'; import { S3Service } from '@/s3/s3.service'; import { UpdateProfileDto } from './UpdateProfileDto'; import { CreatorOnboardingDto, UpdateHeadlineDto, PublishCreatorDto, UpdateCreatorCategoryDto, } from './users.dto'; @Controller('users') @UseGuards(AuthGuard('jwt')) export class UsersController { constructor( private readonly usersService: UsersService, private readonly s3Service: S3Service, ) {} @Put('profile') async updateProfile(@Req() req, @Body() updateProfileDto: UpdateProfileDto) { return this.usersService.updateProfile(req.user.userId, updateProfileDto); } @Put('profile/photo') @UseInterceptors( FileInterceptor('photo', { limits: { fileSize: 5 * 1024 * 1024 }, }), ) async updateProfilePhoto( @Req() req, @UploadedFile( new ParseFilePipe({ validators: [ new MaxFileSizeValidator({ maxSize: 5 * 1024 * 1024 }), new FileTypeValidator({ fileType: /(jpg|jpeg|png)$/ }), ], }), ) file: Express.Multer.File, ) { try { const user = await this.usersService.findById(req.user.userId); if (!user) { throw new Error('User not found'); } const photoUrl = await this.s3Service.uploadFile( file, req.user.userId, 'patreon-clone-test-dps', ); if (user.profilePicture) { try { await this.s3Service.deleteFile( user.profilePicture, 'patreon-clone-test-dps', ); } catch (error) { console.error('Failed to delete old profile photo:', error); } } return this.usersService.updateProfilePhoto(req.user.userId, photoUrl); } catch (error) { throw new BadRequestException( `Failed to update profile photo: ${error.message}`, ); } } @Post('onboard-creator') async onboardCreator( @Request() req, @Body() creatorData: CreatorOnboardingDto, ) { if (!req.user?.userId) { throw new UnauthorizedException('User not authenticated'); } return this.usersService.onboardCreator(req.user.userId, creatorData); } @Post('publish-creator') async publishCreator(@Request() req, @Body() publishData: PublishCreatorDto) { if (!req.user?.userId) { throw new UnauthorizedException('User not authenticated'); } if (publishData.acceptTerms === false) { throw new BadRequestException('You must accept the terms to continue'); } return this.usersService.publishCreator(req.user.userId, publishData); } @Put('profile/cover') @UseInterceptors( FileInterceptor('cover', { limits: { fileSize: 5 * 1024 * 1024 }, // 5MB }), ) async updateProfileCover( @Req() req, @UploadedFile( new ParseFilePipe({ validators: [ new MaxFileSizeValidator({ maxSize: 5 * 1024 * 1024 }), new FileTypeValidator({ fileType: /(jpg|jpeg|png)$/ }), ], }), ) file: Express.Multer.File, ) { try { const user = await this.usersService.findById(req.user.userId); const bucket = 'patreon-clone-test-cover'; if (user.profileCover) { try { await this.s3Service.deleteFile(user.profileCover, bucket); } catch (error) { console.error('Failed to delete old profile cover:', error); } } const coverUrl = await this.s3Service.uploadFile( file, req.user.userId, bucket, ); return this.usersService.updateProfileCover(req.user.userId, coverUrl); } catch (error) { throw new BadRequestException( `Failed to update profile cover: ${error.message}`, ); } } @Post('stripe-onboarding/complete') async completeStripeOnboarding(@Request() req) { if (!req.user?.userId) { throw new UnauthorizedException('User not authenticated'); } return this.usersService.updateStripeOnboardingStatus(req.user.userId); } @Put('creator/headline') async updateCreatorHeadline( @Request() req, @Body() updateHeadlineDto: UpdateHeadlineDto, ) { return this.usersService.updateCreatorHeadline( req.user.userId, updateHeadlineDto, ); } @Get('creators/published') async getPublishedCreators() { return this.usersService.getPublishedCreators(); } @Put('creator/category') async updateCreatorCategory( @Request() req, @Body() updateCategoryDto: UpdateCreatorCategoryDto, ) { return this.usersService.updateCreatorCategory( req.user.userId, updateCategoryDto, ); } }
