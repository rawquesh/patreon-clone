  async updateStripeOnboardingStatus(userId: string): Promise<{
    user: User;
    accountStatus: {
      isEnabled: boolean;
      requiresAction: boolean;
      actionNeeded?: string[];
    };
  }> {
    const user = await this.userModel.findById(userId);
    if (!user) {
      throw new NotFoundException('User not found');
    }

    if (!user.stripeConnectAccountId) {
      throw new BadRequestException('User has not started Stripe onboarding');
    }

    const accountStatus =
      await this.paymentsService.getConnectAccountStatus(userId);

    const updateData: any = {
