```ts
import { Injectable } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { User, CreatorStatus } from '@/schemas/users.schema';
import { Post, PostStatus } from '@/schemas/posts.schema';
import { Subscription } from '@/schemas/subscribers.schema';

@Injectable()
export class HomeService {
  constructor(
    @InjectModel(User.name) private userModel: Model<User>,
    @InjectModel(Post.name) private postModel: Model<Post>,
    @InjectModel(Subscription.name)
    private subscriptionModel: Model<Subscription>,
  ) {}

  async getTopCreators(limit: number = 10): Promise<User[]> {
    const topCreatorIds = await this.subscriptionModel.aggregate([
      { $match: { status: 'active' } },
      { $group: { _id: '$creator', count: { $sum: 1 } } },
      { $sort: { count: -1 } },
      { $limit: limit },
    ]);

    const creatorIds = topCreatorIds.map((item) => item._id);

    const creators = await this.userModel
      .find({
        _id: { $in: creatorIds },
        isCreator: true,
        creatorStatus: CreatorStatus.PUBLISHED,
      })
      .select(
        'displayName creatorUsername profilePicture creatorHeadline creatorCategory',
      )
      .limit(limit);

    return creators;
  }

  async getPopularThisWeek(limit: number = 10): Promise<User[]> {
    const oneWeekAgo = new Date();
    oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

    const popularPosts = await this.postModel.aggregate([
      {
        $match: {
          createdAt: { $gte: oneWeekAgo },
          status: PostStatus.PUBLISHED,
          isDeleted: false,
        },
      },
      {
        $addFields: {
          totalEngagement: {
            $add: [
              '$viewCount',
              '$likeCount',
              { $multiply: ['$commentCount', 2] },
              { $multiply: ['$shareCount', 3] },
            ],
          },
        },
      },
      { $sort: { totalEngagement: -1 } },
      { $group: { _id: '$creator', engagement: { $sum: '$totalEngagement' } } },
      { $sort: { engagement: -1 } },
      { $limit: limit },
    ]);

    const creatorIds = popularPosts.map((item) => item._id);

    const creators = await this.userModel
      .find({
        _id: { $in: creatorIds },
        isCreator: true,
        creatorStatus: CreatorStatus.PUBLISHED,
      })
      .select(
        'displayName creatorUsername profilePicture creatorHeadline creatorCategory',
      )
      .limit(limit);

    return creators;
  }

  async getTopCreatorsByCategory(
    category: string,
    limit: number = 10,
  ): Promise<User[]> {
    if (!category) {
      return [];
    }

    const categoryCreators = await this.userModel
      .find({
        isCreator: true,
        creatorStatus: CreatorStatus.PUBLISHED,
        creatorCategory: category,
      })
      .select(
        'displayName creatorUsername profilePicture creatorHeadline creatorCategory _id',
      )
      .limit(limit);

    const creatorIds = categoryCreators.map((creator) => creator._id);

    const subscriptionCounts = await this.subscriptionModel.aggregate([
      {
        $match: {
          creator: { $in: creatorIds },
          status: 'active',
        },
      },
      { $group: { _id: '$creator', count: { $sum: 1 } } },
    ]);

    const countMap = new Map();
    subscriptionCounts.forEach((item) => {
      countMap.set(item._id.toString(), item.count);
    });

    return categoryCreators.sort((a, b) => {
      const countA = countMap.get(a._id.toString()) || 0;
      const countB = countMap.get(b._id.toString()) || 0;
      return countB - countA;
    });
  }

  async getCategories(): Promise<string[]> {
    const categories = await this.userModel.distinct('creatorCategory', {
      isCreator: true,
      creatorStatus: CreatorStatus.PUBLISHED,
      creatorCategory: { $ne: null },
    });

    return categories.filter(Boolean) as string[];
  }

  async getRecentlyVisitedCreators(
    userId?: string,
    limit: number = 10,
  ): Promise<any[]> {
    const creators = await this.userModel
      .find({
        isCreator: true,
        creatorStatus: CreatorStatus.PUBLISHED,
      })
      .select('displayName creatorUsername profilePicture')
      .limit(limit);

    return creators.map((creator) => {
      const randomDays = Math.floor(Math.random() * 7) + 1;
      const lastVisitedAt = new Date();
      lastVisitedAt.setDate(lastVisitedAt.getDate() - randomDays);

      return {
        _id: creator._id,
        displayName: creator.displayName,
        creatorUsername: creator.creatorUsername,
        profilePicture: creator.profilePicture,
        lastVisitedAt: lastVisitedAt.toISOString(),
      };
    });
  }

  async getSubscribedFeed(
    userId: string,
    page: number = 1,
    limit: number = 10,
  ): Promise<{
    posts: any[];
    pagination: {
      total: number;
      page: number;
      limit: number;
      totalPages: number;
    };
  }> {
    // Find all active subscriptions for the user
    const subscriptions = await this.subscriptionModel.find({
      subscriber: userId,
      status: 'active',
    });

    // Extract creator IDs from subscriptions
    const creatorIds = subscriptions.map((sub) => sub.creator);

    // Calculate pagination
    const skip = (page - 1) * limit;

    // Find posts from subscribed creators
    const [posts, total] = await Promise.all([
      this.postModel
        .find({
          creator: { $in: creatorIds },
          status: PostStatus.PUBLISHED,
          isDeleted: false,
        })
        .sort({ createdAt: -1 })
        .skip(skip)
        .limit(limit)
        .populate(
          'creator',
          'displayName creatorUsername profilePicture creatorCategory',
        )
        .exec(),

      this.postModel.countDocuments({
        creator: { $in: creatorIds },
        status: PostStatus.PUBLISHED,
        isDeleted: false,
      }),
    ]);

    // Transform posts for response
    const formattedPosts = posts.map((post) => {
      const postObj = post.toObject();

      // Get appropriate preview content based on post type
      let previewText = '';
      if (postObj.textContent) {
        previewText =
          postObj.textContent.substring(0, 150) +
          (postObj.textContent.length > 150 ? '...' : '');
      } else if (postObj.description) {
        previewText = postObj.description;
      }

      // Get post thumbnail
      let thumbnail = postObj.thumbnailUrl;
      if (!thumbnail && postObj.mediaUrls && postObj.mediaUrls.length > 0) {
        thumbnail = postObj.mediaUrls[0];
      }

      // Add computed fields
      const formattedPost = {
        ...postObj,
        id: postObj._id.toString(),
        previewText,
        thumbnail,
        creator: {
          id: postObj.creator._id,
          displayName:
            postObj.creator.displayName || postObj.creator.creatorUsername,
          profilePicture: postObj.creator.profilePicture,
          username: postObj.creator.creatorUsername,
          category: postObj.creator.creatorCategory,
        },
        likesCount: postObj.likeCount || 0,
        commentsCount: postObj.commentCount || 0,
        publishDate: this.formatDate(postObj.createdAt),
        postType: this.getReadablePostType(postObj.type),
        isRestrictedView: false, // Since this is for subscribed posts, the user has access
      };

      return formattedPost;
    });

    // Return feed with pagination info
    return {
      posts: formattedPosts,
      pagination: {
        total,
        page,
        limit,
        totalPages: Math.ceil(total / limit),
      },
    };
  }

  private formatDate(date: Date): string {
    const months = [
      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec',
    ];
    const d = new Date(date);
    return `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
  }

  private getReadablePostType(type: string): string {
    const typeMap = {
      text: 'Text',
      image: 'Picture',
      audio: 'Audio',
      video: 'Video',
      link: 'Link',
    };
    return typeMap[type] || type;
  }
}

