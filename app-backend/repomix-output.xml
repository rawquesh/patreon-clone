import { Controller, Get, Query, BadRequestException } from '@nestjs/common';
import { SearchService } from './search.service';

@Controller('search')
export class SearchController {
  constructor(private readonly searchService: SearchService) {}

  @Get()
  async search(
    @Query('q') query: string,
    @Query('category') category?: string,
  ) {
    if ((!query || query.length < 2) && (!category || category === 'all')) {
      throw new BadRequestException(
        'Search query must be at least 2 characters or a category must be specified',
      );
    }

    const results = await this.searchService.search(query, category);
    return results;
  }

  @Get('creator')
  async searchCreator(
    @Query('q') query: string,
    @Query('category') category?: string,
  ) {
    if ((!query || query.length < 2) && (!category || category === 'all')) {
      throw new BadRequestException(
        'Search query must be at least 2 characters or a category must be specified',
      );
    }

    const creators = await this.searchService.searchCreators(query, category);
    return { creators };
  }

  @Get('posts')
  async searchPosts(
    @Query('q') query: string,
    @Query('category') category?: string,
  ) {
    if (!query || query.length < 2) {
      throw new BadRequestException(
        'Search query must be at least 2 characters',
      );
    }

    const posts = await this.searchService.searchPosts(query, category);
    return { posts };
  }
}
