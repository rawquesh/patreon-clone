<file path="src/search/search.service.ts">
import { Injectable } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { User, CreatorStatus } from '@/schemas/users.schema';
import { Post, PostStatus } from '@/schemas/posts.schema';

@Injectable()
export class SearchService {
  constructor(
    @InjectModel(User.name) private userModel: Model<User>,
    @InjectModel(Post.name) private postModel: Model<Post>,
  ) {}

  async search(query: string, category?: string, fullSearch: boolean = true) {
    // If category is provided, prioritize category-based search
    console.log(fullSearch);
    if (category && category !== 'all') {
      const creators = await this.searchCreators('', category);
      return { creators, posts: [] };
    }

    // Search for creators and posts
    const [creators, posts] = await Promise.all([
      this.searchCreators(query),
      this.searchPosts(query),
    ]);

    return {
      creators,
      posts,
    };
  }

  async searchCreators(query: string, category?: string) {
    if ((!query || query.trim() === '') && category && category !== 'all') {
      return this.userModel
        .find({
          isCreator: true,
          creatorStatus: CreatorStatus.PUBLISHED,
          creatorCategory: category,
        })
        .select(
          '_id displayName creatorUsername profilePicture creatorHeadline creatorCategory',
        )
        .sort({ displayName: 1 })
        .limit(20);
    }

    const filter: any = {
      isCreator: true,
      creatorStatus: CreatorStatus.PUBLISHED,
    };

    if (query && query.trim()) {
      filter.$or = [
        { displayName: { $regex: query, $options: 'i' } },
        { creatorUsername: { $regex: query, $options: 'i' } },
        { creatorHeadline: { $regex: query, $options: 'i' } },
        { creatorCategory: { $regex: query, $options: 'i' } },
      ];
    }

    if (category && category !== 'all') {
      filter.creatorCategory = category;
    }

    const creators = await this.userModel
      .find(filter)
      .select(
        '_id displayName creatorUsername profilePicture creatorHeadline creatorCategory',
      )
      .limit(20);

    return creators;
  }

  async searchPosts(query: string, category?: string) {
    if (!query || query.trim() === '') {
      return [];
    }

    const filter: any = {
      status: PostStatus.PUBLISHED,
      isDeleted: false,
      isActive: true,
    };

    filter.$or = [
      { title: { $regex: query, $options: 'i' } },
      { description: { $regex: query, $options: 'i' } },
      { textContent: { $regex: query, $options: 'i' } },
      { tags: { $regex: query, $options: 'i' } },
    ];

    if (category && category !== 'all') {
      const creatorsWithCategory = await this.userModel
        .find({ creatorCategory: category })
        .select('_id');

      const creatorIds = creatorsWithCategory.map((creator) => creator._id);
      filter.creator = { $in: creatorIds };
    }

    const posts = await this.postModel
      .find(filter)
      .populate({
        path: 'creator',
        select: 'displayName creatorUsername profilePicture creatorCategory',
      })
      .select(
        '_id title description textContent thumbnailUrl mediaUrls createdAt type tags',
      )
      .sort({ createdAt: -1 })
      .limit(20);

    return posts.map((post) => {
      let content = '';
      if (post.textContent) {
        content =
          post.textContent.substring(0, 150) +
          (post.textContent.length > 150 ? '...' : '');
      } else if (post.description) {
        content = post.description;
      }

      let coverImage = post.thumbnailUrl;
      if (!coverImage && post.mediaUrls && post.mediaUrls.length > 0) {
        coverImage = post.mediaUrls[0];
      }

      return {
        _id: post._id,
        title: post.title,
        content,
        coverImage,
        type: post.type,
        creator: post.creator,
        createdAt: post.createdAt.toISOString(),
        tags: post.tags || [],
      };
    });
  }
}
