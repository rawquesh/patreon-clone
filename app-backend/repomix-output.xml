import {
  Injectable,
  ConflictException,
  NotFoundException,
} from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model, Types } from 'mongoose';
import { Collection } from './collections.schema';
import { CreateCollectionDto } from './collections.dto';

@Injectable()
export class CollectionsService {
  constructor(
    @InjectModel(Collection.name) private collectionModel: Model<Collection>,
  ) {}

  async create(
    creatorId: string,
    createCollectionDto: CreateCollectionDto,
    coverImageUrl?: string,
  ): Promise<Collection> {
    const existingCollection = await this.collectionModel.findOne({
      creator: new Types.ObjectId(creatorId),
      title: createCollectionDto.title,
      isDeleted: false,
    });

    if (existingCollection) {
      throw new ConflictException('Collection with this title already exists');
    }

    const collection = new this.collectionModel({
      ...createCollectionDto,
      creator: new Types.ObjectId(creatorId),
      coverImage: coverImageUrl,
    });
    return collection.save();
  }

  async findByCreator(
    creatorId: string,
    includeDeleted: boolean = false,
  ): Promise<Collection[]> {
    const filter: any = {
      creator: new Types.ObjectId(creatorId),
    };

    if (!includeDeleted) {
      filter.isDeleted = false;
    }

    const collections = await this.collectionModel
      .find(filter)
      .sort({ createdAt: -1 })
      .populate('creator', 'displayName creatorUsername profilePicture')
      .exec();

    return collections;
  }

  async findById(collectionId: string): Promise<Collection> {
    if (!Types.ObjectId.isValid(collectionId)) {
      throw new NotFoundException('Invalid collection ID format');
    }

    const collection = await this.collectionModel
      .findById(collectionId)
      .populate('creator', 'displayName creatorUsername profilePicture')
      .exec();

    if (!collection) {
      throw new NotFoundException(
        `Collection with ID ${collectionId} not found`,
      );
    }

    return collection;
  }
}
