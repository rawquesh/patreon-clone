er.toObject(); return result; } return null; } async googleLogin(profile: any) { const { email, firstName, lastName, picture } = profile; console.log({ email }); let user = await this.userModel.findOne({ email }); if (!user) { user = await this.userModel.create({ email, firstName, lastName, profilePicture: picture, provider: AuthProvider.GOOGLE, providerId: profile.id, }); } const token = this.generateToken(user); return { user: { id: user._id, email: user.email, firstName: user.firstName, lastName: user.lastName, }, token, }; } private generateToken(user: User): string { const payload = { email: user.email, sub: user._id }; return this.jwtService.sign(payload); } async getCurrentUser(userId: string) { const user = await this.userModel.findById(userId); if (!user) { throw new Error('User not found'); } // eslint-disable-next-line @typescript-eslint/no-unused-vars const { password, ...userWithoutPassword } = user.toObject(); return userWithoutPassword; } async isUsernameInUse(displayName: string): Promise<boolean> { const user = await this.userModel.findOne({ displayName }); return !!user; } async isEmailInUse(email: string): Promise<{ isInUse: boolean; passwordSet: boolean; }> { const user = await this.userModel.findOne({ email: email.toLowerCase() }); if (user) { return { isInUse: true, passwordSet: !!user.password, }; } else { return { isInUse: false, passwordSet: false, }; } // return !!user; } async register(registerDto: RegisterDto): Promise<AuthResponse> { const { email, password, name } = registerDto; const existingUser = await this.userModel.findOne({ email: email.toLowerCase(), }); if (existingUser) { throw new ConflictException('Email already exists'); } const hashedPassword = await bcrypt.hash(password, 10); const newUser = await this.userModel.create({ email: email.toLowerCase(), password: hashedPassword, displayName: name, provider: AuthProvider.LOCAL, }); const token = this.generateToken(newUser); return { user: newUser, token, }; } }
