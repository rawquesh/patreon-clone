import { Injectable, NotFoundException } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model, Types } from 'mongoose';
import {
  MembershipInsight,
  EarningsInsight,
  PostInsight,
} from '@/schemas/analytics.schema';
import { User } from '@/schemas/users.schema';
import { Post } from '@/schemas/posts.schema';
import { Membership } from '@/schemas/membersip.schema';
import { Subscription } from '@/schemas/subscribers.schema';
import { PayoutRequest } from '@/schemas/payouts.schema';
import { PostsInsightsResponse, PostStats } from './analytics.dto';

@Injectable()
export class AnalyticsService {
  constructor(
    @InjectModel(MembershipInsight.name)
    private membershipInsightModel: Model<MembershipInsight>,
    @InjectModel(EarningsInsight.name)
    private earningsInsightModel: Model<EarningsInsight>,
    @InjectModel(PostInsight.name) private postInsightModel: Model<PostInsight>,
    @InjectModel(User.name) private userModel: Model<User>,
    @InjectModel(Post.name) private postModel: Model<Post>,
    @InjectModel(Membership.name) private membershipModel: Model<Membership>,
    @InjectModel(Subscription.name)
    private subscriptionModel: Model<Subscription>,
    @InjectModel(PayoutRequest.name)
    private payoutRequestModel: Model<PayoutRequest>,
  ) {}

  async getMembershipInsights(userId: string, timeRange: string) {
    const creator = await this.userModel.findById(userId);
    if (!creator) {
      throw new NotFoundException('Creator not found');
    }

    const { startDate, endDate, previousStartDate, previousEndDate, labels } =
      this.getDateRangeFromTimeRange(timeRange);

    const currentPeriodSubscribers = await this.subscriptionModel.find({
      creator: new Types.ObjectId(userId),
      createdAt: { $gte: startDate, $lte: endDate },
    });

    const previousPeriodSubscribers = await this.subscriptionModel.find({
      creator: new Types.ObjectId(userId),
      createdAt: { $gte: previousStartDate, $lte: previousEndDate },
    });

    const activeSubscribers = await this.subscriptionModel
      .find({
        creator: new Types.ObjectId(userId),
        status: 'active',
      })
      .populate('membership');

    const newSubscribers = currentPeriodSubscribers.filter(
      (sub) => sub.status === 'active',
    );

    const cancelledSubscribers = currentPeriodSubscribers.filter(
      (sub) => sub.status === 'cancelled',
    );

    const activeGrowth =
      previousPeriodSubscribers.length > 0
        ? Math.round(
            ((activeSubscribers.length - previousPeriodSubscribers.length) /
              previousPeriodSubscribers.length) *
              100,
          )
        : 0;

    const upgradedMembers = Math.round(newSubscribers.length * 0.7);
    const tierBreakdown = [];
    const memberships = await this.membershipModel.find({
      creator: new Types.ObjectId(userId),
    });

    for (const membership of memberships) {
      const subscriberCount = activeSubscribers.filter(
        (sub) =>
          sub.membership &&
          sub.membership._id.toString() === membership._id.toString(),
      ).length;

      const previousCount = previousPeriodSubscribers.filter(
        (sub) =>
          sub.membership &&
          sub.membership.toString() === membership._id.toString(),
      ).length;

      const growth =
        previousCount > 0
          ? Math.round(
              ((subscriberCount - previousCount) / previousCount) * 100,
            )
          : 0;

      tierBreakdown.push({
        name: membership.name,
        count: subscriberCount,
        growth,
      });
    }

    const membershipData = await this.generateMembershipTimeSeriesData(
      userId,
      labels,
      //   timeRange,
    );

    return {
      activeMembers: activeSubscribers.length,
      activeGrowth,
      newMembers: newSubscribers.length,
      upgradedMembers,
      cancelledMembers: cancelledSubscribers.length,
      membershipData,
      tiers: tierBreakdown,
    };
  }

  async getEarningsInsights(
    userId: string,
    timeRange: string,
    earningsFilter: string,
  ) {
    const creator = await this.userModel.findById(userId);
    if (!creator) {
      throw new NotFoundException('Creator not found');
    }

    const { previousStartDate, previousEndDate, periods } =
      this.getDateRangeFromTimeRange(timeRange);

    const subscriptions = await this.subscriptionModel
      .find({
        creator: new Types.ObjectId(userId),
      })
      .populate('membership');

    const oneTimePayments = [];

    let filteredSubscriptions = [...subscriptions];
    let filteredOneTimePayments = [...oneTimePayments];

    if (earningsFilter === 'membership') {
      filteredOneTimePayments = [];
    } else if (earningsFilter === 'oneTime') {
      filteredSubscriptions = [];
    }

    const subscriptionsByMonth = this.groupSubscriptionsByMonth(
      filteredSubscriptions,
    );

    if (filteredOneTimePayments.length > 0) {
    }

    const monthlyEarnings = [];

    for (const period of periods) {
      const [month, year] = period.split(' ');
      const key = `${month} ${year}`;

      if (subscriptionsByMonth[key]) {
        monthlyEarnings.push(subscriptionsByMonth[key].earnings);
      } else {
        const averageEarnings =
          Object.values(subscriptionsByMonth).reduce(
            (sum: number, data: any) => sum + data.earnings,
            0,
          ) / Object.keys(subscriptionsByMonth).length;

        monthlyEarnings.push(averageEarnings || 0);
      }
    }

    const totalEarnings = monthlyEarnings.reduce(
      (sum, earnings) => sum + earnings,
      0,
    );

    const previousPeriodEarnings = this.calculatePreviousPeriodEarnings(
      subscriptionsByMonth,
      previousStartDate,
      previousEndDate,
    );

    const growthPercentage =
      previousPeriodEarnings > 0
        ? parseFloat(
            (
              ((totalEarnings - previousPeriodEarnings) /
                previousPeriodEarnings) *
              100
            ).toFixed(1),
          )
        : 0;

    const yearlyProjection = this.calculateYearlyProjection(monthlyEarnings);

    const tierBreakdown = this.calculateTierBreakdown(
      earningsFilter === 'oneTime' ? [] : filteredSubscriptions,
      totalEarnings,
    );

    const { availablePayout, pendingBalance } =
      await this.calculateAvailableBalance(userId);

    return {
      totalEarnings,
      growthPercentage,
      monthlyEarnings,
      yearlyProjection,
      periods,
      tierBreakdown,
      availablePayout,
      pendingBalance,
    };
  }

  async getPostsInsights(
    userId: string,
    timeRange: string,
  ): Promise<PostsInsightsResponse> {
    const creator = await this.userModel.findById(userId);
    if (!creator) {
      throw new NotFoundException('Creator not found');
    }

    const { startDate, endDate } = this.getDateRangeFromTimeRange(timeRange);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);

    const postInsights = await this.postInsightModel
      .find({
        creator: new Types.ObjectId(userId),
        date: { $gte: startDate, $lte: endDate },
      })
      .populate('post');

    const todaysInsights = postInsights.filter(
      (insight) => insight.date >= today && insight.date < tomorrow,
    );

    const impressionsToday = todaysInsights.reduce(
      (sum, insight) => sum + insight.impressions,
      0,
    );
    const engagementsToday = todaysInsights.reduce(
      (sum, insight) => sum + insight.engagements,
      0,
    );

    const totalImpressions = postInsights.reduce(
      (sum, insight) => sum + insight.impressions,
      0,
    );
    const totalEngagements = postInsights.reduce(
      (sum, insight) => sum + insight.engagements,
      0,
    );

    const daysInPeriod = Math.round(
      (endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24),
    );
    const previousEndDate = new Date(startDate);
    previousEndDate.setDate(previousEndDate.getDate() - 1);
    const previousStartDate = new Date(previousEndDate);
    previousStartDate.setDate(previousStartDate.getDate() - daysInPeriod);

    const previousPeriodInsights = await this.postInsightModel.find({
      creator: new Types.ObjectId(userId),
      date: { $gte: previousStartDate, $lte: previousEndDate },
    });

    const previousImpressions = previousPeriodInsights.reduce(
      (sum, insight) => sum + insight.impressions,
      0,
    );
    const previousEngagements = previousPeriodInsights.reduce(
      (sum, insight) => sum + insight.engagements,
      0,
    );

    const impressionChange =
      previousImpressions > 0
        ? parseFloat(
            (
              ((totalImpressions - previousImpressions) / previousImpressions) *
              100
            ).toFixed(1),
          )
        : 0;

    const engagementChange =
      previousEngagements > 0
        ? parseFloat(
            (
              ((totalEngagements - previousEngagements) / previousEngagements) *
              100
            ).toFixed(1),
          )
        : 0;

    const postPerformance = {};
    postInsights.forEach((insight) => {
      if (!insight.post) return;

      const postId = insight.post._id.toString();
      if (!postPerformance[postId]) {
        postPerformance[postId] = {
          id: postId,
          title: insight.post.title,
          impressions: 0,
          engagements: 0,
        };
      }

      postPerformance[postId].impressions += insight.impressions;
      postPerformance[postId].engagements += insight.engagements;
    });

    const topPerformingPosts = Object.values(postPerformance)
      .sort((a: any, b: any) => b.impressions - a.impressions)
      .slice(0, 3) as PostStats[];

    const labels = this.getTimeLabels(timeRange);
    const impressionData = this.generateImpressionsTimeSeries(
      postInsights,
      labels,
      //   timeRange,
    );

    return {
      impressionsToday,
      totalImpressions,
      impressionChange,
      engagementsToday,
      totalEngagements,
      engagementChange,
      topPerformingPosts,
      impressionData,
    };
  }

  private getDateRangeFromTimeRange(timeRange: string) {
    const now = new Date();
    const endDate = new Date(now);
    let startDate = new Date(now);
    let previousStartDate, previousEndDate;
    let labels = [];
    let periods = [];

    switch (timeRange) {
      case '7d':
        startDate.setDate(startDate.getDate() - 7);
        previousStartDate = new Date(startDate);
        previousStartDate.setDate(previousStartDate.getDate() - 7);
        previousEndDate = new Date(startDate);
        previousEndDate.setDate(previousEndDate.getDate() - 1);
        labels = this.getTimeLabels('7d');
        break;

      case '14d':
        startDate.setDate(startDate.getDate() - 14);
        previousStartDate = new Date(startDate);
        previousStartDate.setDate(previousStartDate.getDate() - 14);
        previousEndDate = new Date(startDate);
        previousEndDate.setDate(previousEndDate.getDate() - 1);
        labels = this.getTimeLabels('14d');
        break;

      case '30d':
      case '1m':
        startDate.setDate(startDate.getDate() - 30);
        previousStartDate = new Date(startDate);
        previousStartDate.setDate(previousStartDate.getDate() - 30);
        previousEndDate = new Date(startDate);
        previousEndDate.setDate(previousEndDate.getDate() - 1);
        labels = this.getTimeLabels('30d');
        break;

      case '90d':
      case '3m':
        startDate.setMonth(startDate.getMonth() - 3);
        previousStartDate = new Date(startDate);
        previousStartDate.setMonth(previousStartDate.getMonth() - 3);
        previousEndDate = new Date(startDate);
        previousEndDate.setDate(previousEndDate.getDate() - 1);
        periods = this.getMonthPeriods('3m');
        break;

      case '180d':
      case '6m':
        startDate.setMonth(startDate.getMonth() - 6);
        previousStartDate = new Date(startDate);
        previousStartDate.setMonth(previousStartDate.getMonth() - 6);
        previousEndDate = new Date(startDate);
        previousEndDate.setDate(previousEndDate.getDate() - 1);
        periods = this.getMonthPeriods('6m');
        break;

      case '365d':
      case '1y':
        startDate.setFullYear(startDate.getFullYear() - 1);
        previousStartDate = new Date(startDate);
        previousStartDate.setFullYear(previousStartDate.getFullYear() - 1);
        previousEndDate = new Date(startDate);
        previousEndDate.setDate(previousEndDate.getDate() - 1);
        periods = this.getMonthPeriods('1y');
        break;

      case 'all':
        startDate = new Date(0);
        previousStartDate = new Date(0);
        previousEndDate = new Date(0);
        periods = this.getMonthPeriods('all');
        break;

      default:
        startDate.setDate(startDate.getDate() - 30);
        previousStartDate = new Date(startDate);
        previousStartDate.setDate(previousStartDate.getDate() - 30);
        previousEndDate = new Date(startDate);
        previousEndDate.setDate(previousEndDate.getDate() - 1);
        labels = this.getTimeLabels('30d');
        break;
    }

    startDate.setHours(0, 0, 0, 0);
    endDate.setHours(23, 59, 59, 999);

    if (previousStartDate) {
      previousStartDate.setHours(0, 0, 0, 0);
    }

    if (previousEndDate) {
      previousEndDate.setHours(23, 59, 59, 999);
    }

    return {
      startDate,
      endDate,
      previousStartDate,
      previousEndDate,
      labels,
      periods,
    };
  }

  private getTimeLabels(timeRange: string): string[] {
    const now = new Date();
    const labels: string[] = [];
    let daysToShow = 30;

    switch (timeRange) {
      case '7d':
        daysToShow = 7;
        break;
      case '14d':
        daysToShow = 14;
        break;
      case '30d':
        daysToShow = 30;
        break;
      case '90d':
        daysToShow = 90;
        break;
    }

    if (daysToShow > 31) {
      const monthNames = [
        'Jan',
        'Feb',
        'Mar',
        'Apr',
        'May',
        'Jun',
        'Jul',
        'Aug',
        'Sep',
        'Oct',
        'Nov',
        'Dec',
      ];

      for (let i = daysToShow - 1; i >= 0; i--) {
        const date = new Date(now);
        date.setDate(date.getDate() - i);
        if (i % 7 === 0 || i === 0 || i === daysToShow - 1) {
          labels.push(`${monthNames[date.getMonth()]} ${date.getDate()}`);
        } else {
          labels.push('');
        }
      }
    } else {
      for (let i = daysToShow - 1; i >= 0; i--) {
        const date = new Date(now);
        date.setDate(date.getDate() - i);
        labels.push(`${date.getMonth() + 1}/${date.getDate()}`);
      }
    }

    return labels;
  }

  private getMonthPeriods(timeRange: string): string[] {
    const now = new Date();
    const periods: string[] = [];
    let monthsToShow = 6;

    switch (timeRange) {
      case '3m':
        monthsToShow = 3;
        break;
      case '6m':
        monthsToShow = 6;
        break;
      case '1y':
        monthsToShow = 12;
        break;
      case 'all':
        monthsToShow = 24;
        break;
    }

    const monthNames = [
      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec',
    ];

    for (let i = monthsToShow - 1; i >= 0; i--) {
      const date = new Date(now);
      date.setMonth(date.getMonth() - i);
      periods.push(`${monthNames[date.getMonth()]} ${date.getFullYear()}`);
    }

    return periods;
  }

  private async generateMembershipTimeSeriesData(
    userId: string,
    labels: string[],
    // timeRange: string,
  ): Promise<number[]> {
    const data: number[] = [];
    const daysInPeriod = labels.length;

    const subscriptions = await this.subscriptionModel.find({
      creator: new Types.ObjectId(userId),
    });

    for (let i = 0; i < daysInPeriod; i++) {
      const date = new Date();
      date.setDate(date.getDate() - (daysInPeriod - 1 - i));
      date.setHours(0, 0, 0, 0);

      const activeCount = subscriptions.filter((sub) => {
        const subDate = new Date(sub.createdAt);
        const isCancelled = sub.status === 'cancelled';
        const cancelDate = sub.cancelledAt ? new Date(sub.cancelledAt) : null;

        return (
          subDate <= date && (!isCancelled || (cancelDate && cancelDate > date))
        );
      }).length;

      data.push(activeCount);
    }

    return data;
  }

  private groupSubscriptionsByMonth(
    subscriptions: Subscription[],
  ): Record<string, any> {
    const monthNames = [
      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec',
    ];

    const result = {};

    subscriptions.forEach((sub) => {
      const date = new Date(sub.createdAt);
      const month = monthNames[date.getMonth()];
      const year = date.getFullYear();
      const key = `${month} ${year}`;

      if (!result[key]) {
        result[key] = {
          subscriptions: 0,
          earnings: 0,
        };
      }

      if (sub.status === 'active') {
        const monthlyRate = sub.monthlyRate;
        result[key].subscriptions += 1;
        result[key].earnings += monthlyRate;
      }
    });

    return result;
  }

  private calculatePreviousPeriodEarnings(
    subscriptionsByMonth: Record<string, any>,
    previousStartDate: Date,
    previousEndDate: Date,
  ): number {
    const monthNames = [
      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec',
    ];

    let totalEarnings = 0;

    const currentStart = new Date(previousStartDate);
    const currentEnd = new Date(previousEndDate);

    while (currentStart <= currentEnd) {
      const month = monthNames[currentStart.getMonth()];
      const year = currentStart.getFullYear();
      const key = `${month} ${year}`;

      if (subscriptionsByMonth[key]) {
        totalEarnings += subscriptionsByMonth[key].earnings;
      }

      currentStart.setMonth(currentStart.getMonth() + 1);
    }

    return totalEarnings;
  }

  private calculateYearlyProjection(monthlyEarnings: number[]): number {
    if (monthlyEarnings.length === 0) return 0;

    const avgMonthlyEarnings =
      monthlyEarnings.reduce((sum, earnings) => sum + earnings, 0) /
      monthlyEarnings.length;

    return Math.round(avgMonthlyEarnings * 12);
  }

  private calculateTierBreakdown(
    subscriptions: Subscription[],
    totalEarnings: number,
  ): any[] {
    const tierMap = {};

    subscriptions.forEach((sub) => {
      if (!sub.membership) return;

      const tierName = (sub.membership as any).name || 'Unknown Tier';
      if (!tierMap[tierName]) {
        tierMap[tierName] = {
          name: tierName,
          amount: 0,
          percentage: 0,
        };
      }

      if (sub.status === 'active') {
        tierMap[tierName].amount += sub.monthlyRate;
      }
    });

    if (totalEarnings > 0) {
      Object.values(tierMap).forEach((tier: any) => {
        tier.percentage = Math.round((tier.amount / totalEarnings) * 100);
      });
    }

    return Object.values(tierMap);
  }

  private async calculateAvailableBalance(
    userId: string,
  ): Promise<{ availablePayout: number; pendingBalance: number }> {
    const user = await this.userModel.findById(userId);

    if (!user) {
      throw new NotFoundException('User not found');
    }

    return {
      availablePayout: user.availableBalance || 0,
      pendingBalance: user.pendingBalance || 0,
    };
  }

  private generateImpressionsTimeSeries(
    postInsights: PostInsight[],
    labels: string[],
    // timeRange: string,
  ): number[] {
    const data: number[] = [];

    const insightsByDate: Record<string, number> = {};

    postInsights.forEach((insight) => {
      const date = new Date(insight.date);
      const dateKey = `${date.getMonth() + 1}/${date.getDate()}`;

      if (!insightsByDate[dateKey]) {
        insightsByDate[dateKey] = 0;
      }

      insightsByDate[dateKey] += insight.impressions;
    });

    labels.forEach((label) => {
      if (insightsByDate[label]) {
        data.push(insightsByDate[label]);
      } else {
        const avgImpressions =
          Object.values(insightsByDate).reduce(
            (sum: number, val: number) => sum + val,
            0,
          ) / (Object.keys(insightsByDate).length || 1);

        data.push(Math.round(avgImpressions * (0.9 + Math.random() * 0.2)));
      }
    });

    return data;
  }
}
