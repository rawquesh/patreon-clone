      isDeleted: false,
    });

    if (!discount) {
      throw new NotFoundException('Discount not found');
    }

    await this.discountModel.findByIdAndUpdate(discountId, {
      $set: { isDeleted: true, status: DiscountStatus.INACTIVE },
