import { Injectable, NotFoundException, BadRequestException, ConflictException, } from '@nestjs/common'; import { InjectModel } from '@nestjs/mongoose'; import { Model, Types } from 'mongoose'; import { User, CreatorStatus } from '@/schemas/users.schema'; import { UpdateProfileDto } from './UpdateProfileDto'; import { CreatorOnboardingDto, UpdateHeadlineDto, PublishCreatorDto, UpdateCreatorCategoryDto, } from './users.dto'; import { PaymentsService } from '@/payments/payments.service'; @Injectable() export class UsersService { constructor( @InjectModel(User.name) private userModel: Model<User>, private paymentsService: PaymentsService, ) {} async findById(userId: string): Promise<User> { const user = await this.userModel.findById(userId); if (!user) { throw new NotFoundException('User not found'); } return user; } async updateProfile( userId: string, updateProfileDto: UpdateProfileDto, ): Promise<User> { const user = await this.userModel.findById(userId); if (!user) { throw new NotFoundException('User not found'); } if (updateProfileDto.email && updateProfileDto.email !== user.email) { const existingUser = await this.userModel.findOne({ email: updateProfileDto.email, }); if (existingUser) { throw new BadRequestException('Email already exists'); } } const updatedUser = await this.userModel.findByIdAndUpdate( userId, { $set: { ...updateProfileDto, updatedAt: new Date(), }, }, { new: true, runValidators: true }, ); if (!updatedUser) { throw new NotFoundException('User not found'); } return updatedUser; } async updateProfilePhoto(userId: string, photoUrl: string): Promise<User> { console.log('Updating profile photo for user:', userId); console.log('New photo URL:', photoUrl); if (!Types.ObjectId.isValid(userId)) { throw new Error('Invalid user ID format'); } try { const updatedUser = await this.userModel.findOneAndUpdate( { _id: new Types.ObjectId(userId) }, { $set: { profilePicture: photoUrl, updatedAt: new Date(), }, }, { new: true, runValidators: true }, ); console.log('Updated user result:', updatedUser); if (!updatedUser) { throw new NotFoundException(`User with ID ${userId} not found`); } return updatedUser; } catch (error) { console.error('Error updating user profile photo:', error); throw error; } } async onboardCreator( userId: string, creatorData: CreatorOnboardingDto, ): Promise<User> { if (!Types.ObjectId.isValid(userId)) { throw new Error('Invalid user ID format'); } const user = await this.userModel.findById(userId); if (!user) { throw new NotFoundException(`User with ID ${userId} not found`); } const existingUsername = await this.userModel.findOne({ creatorUsername: creatorData.username.toLowerCase(), }); if (existingUsername) { throw new ConflictException('Username is already taken'); } const updatedUser = await this.userModel.findOneAndUpdate( { _id: new Types.ObjectId(userId) }, { $set: { creatorUsername: creatorData.username.toLowerCase(), contentVisibleTo: creatorData.contentVisibleTo, isCreator: true, creatorStatus: CreatorStatus.DRAFT, updatedAt: new Date().toISOString(), creatorCategory: creatorData.category, }, }, { new: true, runValidators: true }, ); if (!updatedUser) { throw new NotFoundException(`User with ID ${userId} not found`); } return updatedUser; } async publishCreator( userId: string, publishData: PublishCreatorDto, ): Promise<{ user: User; stripeOnboardingUrl: string }> { console.log(publishData); const user = await this.userModel.findById(userId); if (!user) { throw new NotFoundException('User not found'); } if (!user.isCreator) { throw new BadRequestException('User is not a creator'); } if (user.creatorStatus === CreatorStatus.PUBLISHED) { throw new BadRequestException('Creator is already published'); } const { accountId, accountLinkUrl } = await this.paymentsService.createConnectAccount(userId, user.email); const updatedUser = await this.userModel.findByIdAndUpdate( userId, { $set: { stripeConnectAccountId: accountId, hasCompletedStripeOnboarding: false, creatorStatus: CreatorStatus.ONBOARDING, updatedAt: new Date().toISOString(), }, }, { new: true }, ); return { user: updatedUser, stripeOnboardingUrl: accountLinkUrl }; } async updateProfileCover(userId: string, coverUrl: string): Promise<User> { console.log('Updating profile cover for user:', userId); console.log('New cover URL:', coverUrl); if (!Types.ObjectId.isValid(userId)) { throw new Error('Invalid user ID format'); } try { const updatedUser = await this.userModel.findOneAndUpdate( { _id: new Types.ObjectId(userId) }, { $set: { profileCover: coverUrl, updatedAt: new Date().toISOString(), }, }, { new: true, runValidators: true }, ); console.log('Updated user result:', updatedUser); if (!updatedUser) { throw new NotFoundException(`User with ID ${userId} not found`); } return updatedUser; } catch (error) { console.error('Error updating user profile cover:', error); throw error; } } async updateCreatorHeadline( userId: string, { headline }: UpdateHeadlineDto, ): Promise<User> { if (!Types.ObjectId.isValid(userId)) { throw new Error('Invalid user ID format'); } const updatedUser = await this.userModel.findOneAndUpdate( { _id: new Types.ObjectId(userId) }, { $set: { creatorHeadline: headline, updatedAt: new Date().toISOString(), }, }, { new: true, runValidators: true }, ); if (!updatedUser) { throw new NotFoundException('User not found'); } return updatedUser; } async updateStripeOnboardingStatus(userId: string): Promise<{ user: User; accountStatus: { isEnabled: boolean; requiresAction: boolean; actionNeeded?: string[]; }; }> { const user = await this.userModel.findById(userId); if (!user) { throw new NotFoundException('User not found'); } if (!user.stripeConnectAccountId) { throw new BadRequestException('User has not started Stripe onboarding'); } const accountStatus = await this.paymentsService.getConnectAccountStatus(userId); const updateData: any = { hasCompletedStripeOnboarding: accountStatus.isEnabled, updatedAt: new Date().toISOString(), }; if (accountStatus.isEnabled) { updateData.creatorStatus = CreatorStatus.PUBLISHED; } const updatedUser = await this.userModel.findByIdAndUpdate( userId, { $set: updateData }, { new: true }, ); if (!updatedUser) { throw new NotFoundException('User not found after update'); } return { user: updatedUser, accountStatus }; } async getPublishedCreators(): Promise<User[]> { return this.userModel.find({ isCreator: true, creatorStatus: CreatorStatus.PUBLISHED, }); } async updateCreatorCategory( userId: string, updateCategoryDto: UpdateCreatorCategoryDto, ): Promise<User> { if (!Types.ObjectId.isValid(userId)) { throw new Error('Invalid user ID format'); } const user = await this.userModel.findById(userId); if (!user) { throw new NotFoundException('User not found'); } if (!user.isCreator) { throw new BadRequestException('User is not a creator'); } const updatedUser = await this.userModel.findOneAndUpdate( { _id: new Types.ObjectId(userId) }, { $set: { creatorCategory: updateCategoryDto.category, updatedAt: new Date().toISOString(), }, }, { new: true, runValidators: true }, ); if (!updatedUser) { throw new NotFoundException('User not found after update'); } return updatedUser; } }
