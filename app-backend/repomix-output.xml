ber; @Prop({ type: String, enum: GiftType, default: GiftType.FREE_TRIAL, }) giftType: GiftType; @Prop({ required: true }) durationDays: number; @Prop({ type: String, enum: DiscountApplicability, default: DiscountApplicability.ALL, }) applicableTo: DiscountApplicability; @Prop({ type: [{ type: MongooseSchema.Types.ObjectId, ref: 'Membership' }] }) applicableTiers?: Membership[]; @Prop({ required: true }) startDate: Date; @Prop({ required: true }) endDate: Date; @Prop({ default: false }) isPublic: boolean; @Prop({ type: MongooseSchema.Types.ObjectId, ref: 'User', required: true }) creator: User; @Prop({ default: false }) isDeleted: boolean; } export const GiftSchema = SchemaFactory.createForClass(Gift); // Create a record of redemptions @Schema({ timestamps: true }) export class PromotionRedemption extends Document { @Prop({ type: MongooseSchema.Types.ObjectId, refPath: 'promotionType', required: true, }) promotion: Discount | Gift; @Prop({ type: String, required: true, enum: ['Discount', 'Gift'], }) promotionType: string; @Prop({ type: MongooseSchema.Types.ObjectId, ref: 'User', required: true, }) user: User; @Prop({ type: MongooseSchema.Types.ObjectId, ref: 'User', required: true, }) creator: User; @Prop({ type: MongooseSchema.Types.ObjectId, ref: 'Membership', required: true, }) membership: Membership; @Prop({ default: null }) expiryDate?: Date; @Prop({ default: false }) isExpired: boolean; } export const PromotionRedemptionSchema = SchemaFactory.createForClass(PromotionRedemption); DiscountSchema.index({ code: 1 }, { unique: true }); DiscountSchema.index({ creator: 1, status: 1 }); DiscountSchema.index({ startDate: 1, endDate: 1 }); DiscountSchema.index({ isDeleted: 1 }); GiftSchema.index({ code: 1 }, { unique: true }); GiftSchema.index({ creator: 1, status: 1 }); GiftSchema.index({ startDate: 1, endDate: 1 }); GiftSchema.index({ isDeleted: 1 }); PromotionRedemptionSchema.index({ promotion: 1, user: 1 }, { unique: true }); PromotionRedemptionSchema.index({ creator: 1 }); PromotionRedemptionSchema.index({ expiryDate: 1 });
