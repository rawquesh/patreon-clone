    try {
      const memberships = await this.membershipModel.find({
        creator: req.user.userId,
        isActive: true,
        stripeProductId: { $exists: false },
      });

      const results = [];
      for (const membership of memberships) {
        try {
          const updated =
            await this.membershipsService.ensureStripeProductForMembership(
