  async checkPostAccess(
    userId: string | undefined | null,
    post: Post,
  ): Promise<boolean> {
    try {
      // Public posts (no tierAccess) are always accessible
      if (!post.tierAccess || post.tierAccess.length === 0) {
        return true;
      }

      if (!userId) {
        return false;
      }

      // Safely extract creator ID regardless of whether it's populated or not
      let creatorId: string;
      if (typeof post.creator === 'object' && post.creator !== null) {
        // Handle populated creator (User object)
        creatorId = post.creator._id?.toString();
      } else {
        // Handle unpopulated creator (just ObjectId)
        creatorId = post.creator?.toString();
      }

      if (!creatorId) {
        console.error('Creator ID missing on post for access check:', post._id);
        return false; // Cannot check access without creator ID
      }

      // If the user is the creator, they always have access
      if (creatorId === userId) {
        return true;
      }

      // Check if the user has an active subscription to one of the required tiers
      const requiredTierObjectIds = post.tierAccess
        .map((id) => {
          try {
            return new Types.ObjectId(id);
          } catch (e) {
            console.log(e);
            console.error(`Invalid tier ID format in post ${post._id}: ${id}`);
            return null;
          }
        })
        .filter((id) => id !== null); // Filter out any invalid IDs

      if (requiredTierObjectIds.length === 0 && post.tierAccess.length > 0) {
        console.warn(
          `Post ${post._id} has tierAccess defined but contains invalid IDs.`,
        );
        return false; // Safer to restrict if tiers are specified but invalid
      }

      if (requiredTierObjectIds.length === 0) return true; // Should have been caught by first check, but safe

      const subscription = await this.subscriptionModel.findOne({
        subscriber: new Types.ObjectId(userId),
        creator: new Types.ObjectId(creatorId),
        status: 'active',
        membership: { $in: requiredTierObjectIds },
      });

      return !!subscription;
    } catch (error) {
      console.error(`Error in checkPostAccess for post ${post._id}:`, error);
      return false; // Safer to deny access on error
    }
  }

