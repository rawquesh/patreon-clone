import * as bcrypt from 'bcrypt'; import * as fs from 'fs'; import * as path from 'path'; import { connect } from 'mongoose'; import { UserSchema, AuthProvider, CreatorStatus, ContentVisibility, } from './src/schemas/users.schema'; import { S3Client, PutObjectCommand } from '@aws-sdk/client-s3'; import { config } from 'dotenv'; config(); const mockUsersData = JSON.parse( fs.readFileSync(path.join(__dirname, 'mock-users.json'), 'utf8'), ); const MONGODB_URI = process.env.MONGODB_URI || 'mongodb://localhost:27017/patreon-clone'; const s3Client = new S3Client({ region: process.env.AWS_REGION || 'us-east-1', credentials: { accessKeyId: process.env.AWS_ACCESS_KEY || '', secretAccessKey: process.env.AWS_SECRET_KEY || '', }, }); const S3_BUCKET = process.env.S3_PROFILE_BUCKET || 'patreon-clone-test-dps'; async function uploadFileToS3(filePath: string, key: string): Promise<string> { try { const fileContent = fs.readFileSync(filePath); const command = new PutObjectCommand({ Bucket: S3_BUCKET, Key: key, Body: fileContent, ContentType: getContentType(filePath), }); await s3Client.send(command); return `https://${S3_BUCKET}.s3.${process.env.AWS_REGION}.amazonaws.com/${key}`; } catch (error) { console.error(`Failed to upload file to S3: ${error.message}`); throw error; } } function getContentType(filePath: string): string { const ext = path.extname(filePath).toLowerCase(); switch (ext) { case '.jpg': case '.jpeg': return 'image/jpeg'; case '.png': return 'image/png'; case '.gif': return 'image/gif'; default: return 'application/octet-stream'; } } async function seedDatabase() { try { const connection = await connect(MONGODB_URI); console.log('Connected to MongoDB'); const UserModel = connection.model('User', UserSchema); if (!process.env.AWS_ACCESS_KEY || !process.env.AWS_SECRET_KEY) { console.warn('AWS credentials not set. S3 uploads will likely fail.'); } await UserModel.deleteMany({}); console.log('Cleared existing users'); const password = 'password1234'; const hashedPassword = await bcrypt.hash(password, 10); const createdUsers = []; const malePhPath = path.join( process.cwd(), 'profile-pictures', 'placeholder-male.jpg', ); const femalePhPath = path.join( process.cwd(), 'profile-pictures', 'placeholder-female.png', ); let malePlaceholderUrl; let femalePlaceholderUrl; try { console.log('Uploading placeholder male image to S3...'); malePlaceholderUrl = await uploadFileToS3( malePhPath, 'profile-pictures/placeholder-male.jpg', ); console.log( `Successfully uploaded male placeholder to ${malePlaceholderUrl}`, ); console.log('Uploading placeholder female image to S3...'); femalePlaceholderUrl = await uploadFileToS3( femalePhPath, 'profile-pictures/placeholder-female.png', ); console.log( `Successfully uploaded female placeholder to ${femalePlaceholderUrl}`, ); } catch (error) { console.error('Error uploading placeholder images:', error); malePlaceholderUrl = ''; femalePlaceholderUrl = ''; } for (const mockUser of mockUsersData) { try { const pictureName = path.basename(mockUser.profilePicture); const localPicturePath = path.join( process.cwd(), 'profile-pictures', pictureName, ); let profilePictureUrl; if (fs.existsSync(localPicturePath)) { // If the specific image exists, upload it console.log( `Uploading profile picture for ${mockUser.displayName} to S3...`, ); const s3Key = `${mockUser.creatorUsername}/${pictureName}`; profilePictureUrl = await uploadFileToS3(localPicturePath, s3Key); console.log(`Successfully uploaded to ${profilePictureUrl}`); } else { // If specific image doesn't exist, use the appropriate placeholder URL console.log(`Using placeholder image for ${mockUser.displayName}`); if (mockUser.gender === 'Female') { profilePictureUrl = femalePlaceholderUrl; } else { profilePictureUrl = malePlaceholderUrl; } console.log(`Using placeholder image: ${profilePictureUrl}`); } const user = new UserModel({ email: mockUser.email, password: hashedPassword, provider: AuthProvider.LOCAL, displayName: mockUser.displayName, gender: mockUser.gender, profilePicture: profilePictureUrl, creatorUsername: mockUser.creatorUsername, creatorHeadline: mockUser.creatorHeadline, isCreator: true, creatorStatus: CreatorStatus.PUBLISHED, hasCompletedStripeOnboarding: true, stripeCustomerId: `cus_${Math.random().toString(36).substring(2, 15)}`, stripeConnectAccountId: `acct_${Math.random().toString(36).substring(2, 15)}`, contentVisibleTo: ContentVisibility.BOTH, createdAt: new Date(), updatedAt: new Date(), }); await user.save(); createdUsers.push(user); console.log(`Created user: ${mockUser.displayName}`); } catch (error) { console.error(`Error processing user ${mockUser.displayName}:`, error); } } console.log(`Successfully created ${createdUsers.length} users`); console.log('Database seeding completed successfully'); await connection.disconnect(); console.log('Disconnected from MongoDB'); return { success: true, count: createdUsers.length }; } catch (error) { console.error('Error seeding database:', error); return { success: false, error }; } } seedDatabase() .then((result) => { if (result.success) { console.log(`Successfully seeded database with ${result.count} users`); process.exit(0); } else { console.error('Failed to seed database'); process.exit(1); } }) .catch((err) => { console.error('Unhandled error during seeding:', err); process.exit(1); });
