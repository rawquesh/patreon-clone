import { Injectable, BadRequestException, NotFoundException, ConflictException, } from '@nestjs/common'; import { InjectModel } from '@nestjs/mongoose'; import { Model, Types } from 'mongoose'; import { PaymentsService } from '@/payments/payments.service'; import { User } from '@/schemas/users.schema'; import { UpdateMembershipDto, CreatePayoutRequestDto, GetMembershipsQueryDto, CreateMembershipWithFileDto, } from './memberships.dto'; import { Membership } from '@/schemas/membersip.schema'; import { Subscription } from '@/schemas/subscribers.schema'; import { PayoutRequest } from '@/schemas/payouts.schema'; import { NotificationGeneratorService } from '@/notifications/notification-generator.service'; @Injectable() export class MembershipsService { private readonly platformFeePercentage: number; constructor( @InjectModel(Membership.name) private membershipModel: Model<Membership>, @InjectModel(Subscription.name) private subscriptionModel: Model<Subscription>, @InjectModel(PayoutRequest.name) private payoutRequestModel: Model<PayoutRequest>, @InjectModel(User.name) private userModel: Model<User>, private paymentsService: PaymentsService, private notificationGenerator: NotificationGeneratorService, ) { this.platformFeePercentage = 15; } async createMembership( userId: string, createMembershipDto: CreateMembershipWithFileDto, ): Promise<Membership> { const user = await this.userModel.findById(userId); if (!user) { throw new NotFoundException('User not found'); } const existingMembership = await this.membershipModel.findOne({ creator: userId, name: createMembershipDto.name, isActive: true, }); if (existingMembership) { throw new ConflictException('A membership with this name already exists'); } const membership = new this.membershipModel({ ...createMembershipDto, creator: userId, isActive: createMembershipDto.isActive ?? true, }); return membership.save(); } async updateMembership( userId: string, membershipId: string, updateMembershipDto: UpdateMembershipDto, ): Promise