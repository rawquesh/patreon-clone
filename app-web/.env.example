# ── API ─────────────────────────────────────────────────────────────────────
# Base URL of the NestJS backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public URL of this web app itself (used for share links, canonical URLs,
# and OAuth redirect handling). Set to your deployed domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S3-compatible bucket that serves publicly hosted post/collection media.
# Must be prefixed onto media URLs returned by the backend.
NEXT_PUBLIC_API_IMAGE_BUCKET=your-public-media-bucket

# ── Contact forms (optional) ────────────────────────────────────────────────
# Access key for a Web3Forms (or similar) contact-form endpoint.
# Leave blank to disable the contact form.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
